label live-@FLAVOUR@
	menu label ^RiOS 2026 Live (Debian 12 Bookworm)
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ quiet splash

label live-@FLAVOUR@-toram
	menu label RiOS 2026 Live (Copy to RAM)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ toram quiet splash

label live-@FLAVOUR@-failsafe
	menu label RiOS 2026 Live (Fail-safe mode)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@

