#!/usr/bin/env bash
# ==============================================================================
# RiOS Screenshot & Screen Recording Engine
# Uses grim, slurp, wl-clipboard, and wf-recorder
# ==============================================================================

set -euo pipefail

TARGET_DIR="${HOME}/Pictures/Screenshots"
RECORD_DIR="${HOME}/Videos/Recordings"
mkdir -p "${TARGET_DIR}" "${RECORD_DIR}"

TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
MODE="${1:-full}"

case "$MODE" in
    full)
        FILE="${TARGET_DIR}/RiOS_Screenshot_${TIMESTAMP}.png"
        grim "${FILE}"
        wl-copy < "${FILE}"
        notify-send -i "${FILE}" "RiOS Screenshot" "Full screen saved to ${FILE} and copied to clipboard."
        ;;

    area)
        FILE="${TARGET_DIR}/RiOS_Selection_${TIMESTAMP}.png"
        GEOM=$(slurp)
        if [ -n "$GEOM" ]; then
            grim -g "${GEOM}" "${FILE}"
            wl-copy < "${FILE}"
            notify-send -i "${FILE}" "RiOS Screenshot" "Selection saved to ${FILE} and copied to clipboard."
        fi
        ;;

    record)
        REC_FILE="${RECORD_DIR}/RiOS_Record_${TIMESTAMP}.mp4"
        if pgrep -x wf-recorder >/dev/null 2>&1; then
            pkill -INT -x wf-recorder
            notify-send "RiOS Recorder" "Recording stopped and saved to ${RECORD_DIR}."
        else
            GEOM=$(slurp)
            if [ -n "$GEOM" ]; then
                notify-send "RiOS Recorder" "Recording started. Press Super+Shift+R to stop."
                wf-recorder -g "${GEOM}" -f "${REC_FILE}" &
            fi
        fi
        ;;
esac
