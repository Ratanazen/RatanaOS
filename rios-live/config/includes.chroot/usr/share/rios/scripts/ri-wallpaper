#!/usr/bin/env bash
# ==============================================================================
# RiOS Wallpaper Management Engine
# Supports random, next, and specific wallpaper setting with swww/swaybg transitions
# ==============================================================================

set -euo pipefail

WALLPAPER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ri/wallpapers"
STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ri/.current-wallpaper"
SYSTEM_WALLPAPER_DIR="/usr/share/backgrounds/rios"

mkdir -p "${WALLPAPER_DIR}"

get_all_wallpapers() {
    find "${WALLPAPER_DIR}" "${SYSTEM_WALLPAPER_DIR}" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) 2>/dev/null | sort -u
}

apply_wallpaper() {
    local target="$1"
    if [ ! -f "$target" ]; then
        echo "Error: Wallpaper '$target' does not exist." >&2
        exit 1
    fi

    echo "==> Setting wallpaper: $target"
    echo "$target" > "${STATE_FILE}"

    # Try swww first with wipe transition
    if command -v swww >/dev/null 2>&1; then
        if ! pgrep -x swww-daemon >/dev/null 2>&1; then
            swww-daemon &
            sleep 0.5
        fi
        swww img "$target" --transition-type wipe --transition-fps 60 --transition-step 90 2>/dev/null || true
    fi

    # Fallback to swaybg
    if command -v swaybg >/dev/null 2>&1; then
        pkill swaybg 2>/dev/null || true
        swaybg -i "$target" -m fill &
    fi

    # Update GNOME background if in GNOME session
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.background picture-uri "file://${target}" 2>/dev/null || true
        gsettings set org.gnome.desktop.background picture-uri-dark "file://${target}" 2>/dev/null || true
    fi
}

ACTION="${1:-next}"

case "$ACTION" in
    set)
        if [ -z "${2:-}" ]; then
            echo "Usage: ri-wallpaper set <path-to-image>" >&2
            exit 1
        fi
        apply_wallpaper "$2"
        ;;

    random)
        mapfile -t WP_LIST < <(get_all_wallpapers)
        if [ ${#WP_LIST[@]} -eq 0 ]; then
            echo "No wallpapers found." >&2
            exit 1
        fi
        RANDOM_INDEX=$(( RANDOM % ${#WP_LIST[@]} ))
        apply_wallpaper "${WP_LIST[$RANDOM_INDEX]}"
        ;;

    next|*)
        mapfile -t WP_LIST < <(get_all_wallpapers)
        if [ ${#WP_LIST[@]} -eq 0 ]; then
            echo "No wallpapers found." >&2
            exit 1
        fi
        CURRENT=""
        [ -f "${STATE_FILE}" ] && CURRENT=$(cat "${STATE_FILE}")

        NEXT_INDEX=0
        for i in "${!WP_LIST[@]}"; do
            if [ "${WP_LIST[$i]}" = "$CURRENT" ]; then
                NEXT_INDEX=$(( (i + 1) % ${#WP_LIST[@]} ))
                break
            fi
        done
        apply_wallpaper "${WP_LIST[$NEXT_INDEX]}"
        ;;
esac
