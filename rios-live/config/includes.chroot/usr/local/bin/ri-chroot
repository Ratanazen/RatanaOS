#!/usr/bin/env bash
# ==============================================================================
# RiOS Emergency Chroot & System Recovery Tool (2026)
# Automatically locates installed Linux partitions, mounts virtual filesystems,
# and opens an interactive chroot rescue environment.
# ==============================================================================

set -euo pipefail

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

TARGET_MOUNT="/mnt/rios-rescue"

print_banner() {
    echo -e "${RED}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║       RiOS Emergency Chroot & System Recovery Tool       ║"
    echo "║      Repair GRUB, Recover Passwords & Fix Broken Roots   ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

usage() {
    print_banner
    echo -e "${BOLD}Usage:${NC} sudo ri-chroot [partition-device]"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  sudo ri-chroot             (Interactive selection)"
    echo "  sudo ri-chroot /dev/nvme0n1p2"
    echo "  sudo ri-chroot /dev/sda2"
    echo ""
    exit 0
}

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
    exit 1
fi

print_banner

# Discover Linux Root Partitions
TARGET_PART="${1:-}"

if [ -z "$TARGET_PART" ]; then
    echo -e "${BOLD}Scanning for installed Linux partitions...${NC}"
    mapfile -t CANDIDATES < <(lsblk -n -o PATH,FSTYPE,SIZE,LABEL,MOUNTPOINT 2>/dev/null | awk '$2 ~ /^(ext4|btrfs|xfs)$/ && $5 != "/" {print $1}')

    if [ ${#CANDIDATES[@]} -eq 0 ]; then
        echo -e "${RED}No candidate Linux partitions detected!${NC}"
        exit 1
    fi

    echo -e "\nAvailable Linux Partitions:"
    for i in "${!CANDIDATES[@]}"; do
        p="${CANDIDATES[$i]}"
        printf "  [%d] %s (%s, %s)\n" "$((i+1))" "$p" "$(lsblk -d -n -o SIZE "$p" 2>/dev/null)" "$(lsblk -d -n -o FSTYPE "$p" 2>/dev/null)"
    done

    echo ""
    read -rp "Select partition number to mount [1-${#CANDIDATES[@]}]: " CHOICE
    if [[ "$CHOICE" =~ ^[0-9]+$ ]] && [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le ${#CANDIDATES[@]} ]; then
        TARGET_PART="${CANDIDATES[$((CHOICE-1))]}"
    else
        echo -e "${RED}Invalid choice. Aborting.${NC}"
        exit 1
    fi
fi

if [ ! -b "$TARGET_PART" ]; then
    echo -e "${RED}Error: '$TARGET_PART' is not a valid block device!${NC}"
    exit 1
fi

mkdir -p "$TARGET_MOUNT"

echo -e "\n${CYAN}[1/3] Mounting root filesystem: ${TARGET_PART} -> ${TARGET_MOUNT}...${NC}"
mount "$TARGET_PART" "$TARGET_MOUNT"

# Bind mount essential kernel and hardware filesystems
echo -e "${CYAN}[2/3] Bind-mounting /dev, /proc, /sys, and /run...${NC}"
for d in dev dev/pts proc sys run; do
    mkdir -p "${TARGET_MOUNT}/${d}"
    mount --bind "/${d}" "${TARGET_MOUNT}/${d}"
done

# Check if EFI system partition exists on same disk and mount it
PARENT_DISK=$(echo "$TARGET_PART" | sed -E 's/p?[0-9]+$//')
ESP_PART=$(lsblk -n -o PATH,PARTTYPE,FSTYPE "$PARENT_DISK" 2>/dev/null | grep -iE "(c12a7328-f81f-11d2-ba4b-00a0c93ec93b|vfat)" | awk '{print $1}' | head -n 1 || true)

if [ -n "$ESP_PART" ] && [ -b "$ESP_PART" ]; then
    mkdir -p "${TARGET_MOUNT}/boot/efi"
    mount "$ESP_PART" "${TARGET_MOUNT}/boot/efi" 2>/dev/null || true
    echo -e "  ${GREEN}✓${NC} Mounted EFI system partition: ${ESP_PART} -> /boot/efi"
fi

echo -e "\n${GREEN}${BOLD}============================================================${NC}"
echo -e "${GREEN}${BOLD}         ✔ ENTERING RESCUE CHROOT SHELL (${TARGET_PART})     ${NC}"
echo -e "${GREEN}${BOLD}============================================================${NC}"
echo -e "You are now inside the installed system root."
echo -e "Common recovery commands:"
echo -e "  - Fix bootloader:     ${BOLD}grub-install /dev/... && update-grub${NC}"
echo -e "  - Rebuild initramfs:  ${BOLD}update-initramfs -u -k all${NC}"
echo -e "  - Reset password:     ${BOLD}passwd <username>${NC}"
echo -e "  - Type '${BOLD}exit${NC}' to leave chroot and unmount safely."
echo "============================================================"
echo ""

# Execute interactive chroot
chroot "$TARGET_MOUNT" /bin/bash || true

echo -e "\n${CYAN}[3/3] Exited chroot. Cleaning up and unmounting...${NC}"
sync
if mountpoint -q "${TARGET_MOUNT}/boot/efi" 2>/dev/null; then
    umount -l "${TARGET_MOUNT}/boot/efi" 2>/dev/null || true
fi
for d in run sys proc dev/pts dev; do
    if mountpoint -q "${TARGET_MOUNT}/${d}" 2>/dev/null; then
        umount -l "${TARGET_MOUNT}/${d}" 2>/dev/null || true
    fi
done
umount -l "$TARGET_MOUNT" 2>/dev/null || true

echo -e "${GREEN}${BOLD}✔ Recovery environment safely unmounted.${NC}\n"
