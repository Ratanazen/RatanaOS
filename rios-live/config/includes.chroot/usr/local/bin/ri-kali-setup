#!/usr/bin/env bash
# ==============================================================================
# RiOS Kali Linux Repository & Tool Integrator (2026)
# Enables safe integration of Kali Rolling tools on Debian 12 Bookworm with APT pinning
# ==============================================================================

set -euo pipefail

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

print_banner() {
    echo -e "${MAGENTA}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║        RiOS Kali Linux APT Repository Integrator         ║"
    echo "║       Access 600+ Kali Tools with Safe Debian Pinning     ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

usage() {
    print_banner
    echo -e "${BOLD}Usage:${NC} sudo ri-kali-setup <command> [arguments]"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  enable            Configure Kali Rolling APT repo with safe low-priority pinning"
    echo "  disable           Disable Kali Rolling APT repo"
    echo "  status            Check Kali repository and signing key status"
    echo "  install <tool>    Install a tool from Kali repositories (e.g. metasploit-framework)"
    echo "  help              Show this help"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  sudo ri-kali-setup enable"
    echo "  sudo ri-kali-setup install metasploit-framework"
    echo "  sudo ri-kali-setup install exploitdb"
    echo "  sudo ri-kali-setup install burpsuite"
    echo ""
    exit 0
}

KALI_LIST="/etc/apt/sources.list.d/kali.list"
KALI_PREF="/etc/apt/preferences.d/kali.pref"
KEYRING_DIR="/etc/apt/keyrings"
KALI_KEY="${KEYRING_DIR}/kali-archive-keyring.gpg"

cmd_status() {
    print_banner
    echo -e "${BOLD}=== Kali Linux Repository Status ===${NC}"
    if [ -f "$KALI_LIST" ]; then
        echo -e "  Repository Config:   ${GREEN}Active${NC} ($KALI_LIST)"
    else
        echo -e "  Repository Config:   ${YELLOW}Inactive / Disabled${NC}"
    fi

    if [ -f "$KALI_PREF" ]; then
        echo -e "  APT Pinning Guard:   ${GREEN}Configured (Priority 100 - Safe)${NC}"
    else
        echo -e "  APT Pinning Guard:   ${YELLOW}Not configured${NC}"
    fi

    if [ -f "$KALI_KEY" ]; then
        echo -e "  GPG Signing Key:     ${GREEN}Installed${NC} ($KALI_KEY)"
    else
        echo -e "  GPG Signing Key:     ${YELLOW}Missing${NC}"
    fi
    echo ""
}

cmd_enable() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${CYAN}[1/4] Preparing APT keyrings directory...${NC}"
    mkdir -p "$KEYRING_DIR"

    echo -e "${CYAN}[2/4] Downloading official Kali Archive Signing Key...${NC}"
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        apt-get update -qq && apt-get install -y --no-install-recommends curl gnupg
    fi

    # Fetch archive key
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL https://archive.kali.org/archive-key.asc | gpg --dearmor -o "$KALI_KEY" 2>/dev/null || true
    else
        wget -qO - https://archive.kali.org/archive-key.asc | gpg --dearmor -o "$KALI_KEY" 2>/dev/null || true
    fi

    echo -e "${CYAN}[3/4] Configuring Kali Rolling repository list...${NC}"
    cat << EOF > "$KALI_LIST"
# Kali Linux Rolling Repository (Integrated into RiOS)
deb [signed-by=${KALI_KEY}] http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware
EOF

    echo -e "${CYAN}[4/4] Setting APT Pinning (Priority 100 to prevent system breakage)...${NC}"
    cat << 'EOF' > "$KALI_PREF"
# Prevent Kali packages from overriding Debian Bookworm base packages
Package: *
Pin: release o=Kali
Pin-Priority: 100
EOF

    echo -e "\n${BOLD}Updating APT package cache...${NC}"
    apt-get update -o Acquire::AllowInsecureRepositories=false || true

    echo -e "\n${GREEN}${BOLD}✔ Kali Linux Repository successfully integrated!${NC}"
    echo -e "To install any Kali tool without modifying base packages, run:"
    echo -e "  ${BOLD}sudo ri-kali-setup install <package-name>${NC}"
    echo -e "  or: ${BOLD}sudo apt-get install -t kali-rolling <package-name>${NC}"
    echo ""
}

cmd_disable() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${YELLOW}Disabling Kali repository...${NC}"
    rm -f "$KALI_LIST" "$KALI_PREF"
    apt-get update -qq || true
    echo -e "${GREEN}✔ Kali repository disabled.${NC}"
}

cmd_install() {
    local pkg="${1:-}"
    if [ -z "$pkg" ]; then
        echo -e "${RED}Error: Specify package name to install.${NC}"
        echo "Example: sudo ri-kali-setup install metasploit-framework"
        exit 1
    fi

    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    if [ ! -f "$KALI_LIST" ]; then
        echo -e "${YELLOW}Kali repository not enabled yet. Enabling now...${NC}"
        cmd_enable
    fi

    echo -e "\n${BOLD}Installing '$pkg' from Kali Rolling repository...${NC}"
    apt-get install -t kali-rolling -y "$pkg"
    echo -e "\n${GREEN}${BOLD}✔ Successfully installed $pkg!${NC}"
}

case "${1:-status}" in
    status)
        cmd_status
        ;;
    enable)
        cmd_enable
        ;;
    disable)
        cmd_disable
        ;;
    install)
        shift
        cmd_install "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        ;;
esac
