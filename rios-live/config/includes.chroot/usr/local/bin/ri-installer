#!/usr/bin/env bash
# ==============================================================================
# RiOS Master OS Installer (Stage A — Live USB to Real HDD/SSD)
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/disk.sh"
source "${SCRIPT_DIR}/partition.sh"
source "${SCRIPT_DIR}/filesystem.sh"
source "${SCRIPT_DIR}/install-system.sh"
source "${SCRIPT_DIR}/bootloader.sh"
source "${SCRIPT_DIR}/user.sh"
source "${SCRIPT_DIR}/network.sh"
source "${SCRIPT_DIR}/desktop.sh"
source "${SCRIPT_DIR}/finish.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

TARGET_DISK=""
TARGET_MOUNT="/mnt/target"
BOOT_MODE="auto"
USERNAME="ri"
FULLNAME="Ri"
PASSWORD="ri"
HOSTNAME="rios"
DESKTOP_SESSION="rios-hyprland"
NON_INTERACTIVE=0
DRY_RUN=0

print_banner() {
    echo -e "${PURPLE}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                RiOS Master Installer                 ║"
    echo "║       Install RiOS to Real Computer Storage          ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

usage() {
    echo "Usage: ri-installer [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --target <disk>      Target disk device (e.g., /dev/nvme0n1, /dev/sda, /dev/vda)"
    echo "  --user <name>        Primary username (default: ri)"
    echo "  --password <pass>    User and root password (default: ri)"
    echo "  --hostname <host>    Machine hostname (default: rios)"
    echo "  --session <session>  Default session (rios-hyprland, rios-niri, rios-sway)"
    echo "  --mode <uefi|bios>   Force boot mode (default: auto)"
    echo "  --dry-run            Simulate installation without touching any disk"
    echo "  -y, --yes            Skip interactive confirmation (for automated testing)"
    echo "  -h, --help           Show this help"
    exit 0
}

# Parse Arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)     TARGET_DISK="$2"; shift 2 ;;
        --user)       USERNAME="$2"; shift 2 ;;
        --password)   PASSWORD="$2"; shift 2 ;;
        --hostname)   HOSTNAME="$2"; shift 2 ;;
        --session)    DESKTOP_SESSION="$2"; shift 2 ;;
        --mode)       BOOT_MODE="$2"; shift 2 ;;
        --dry-run)    DRY_RUN=1; shift ;;
        -y|--yes)     NON_INTERACTIVE=1; shift ;;
        -h|--help)    usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

print_banner

if [ "$DRY_RUN" -eq 1 ]; then
    echo -e "${CYAN}${BOLD}[NOTICE] Dry run mode enabled. No disks will be altered.${NC}\n"
fi

# 1. Disk Detection & Selection
if [ -z "$TARGET_DISK" ]; then
    echo -e "${BOLD}Scanning for available installation drives...${NC}"
    mapfile -t AVAILABLE_DISKS < <(list_disks)

    if [ ${#AVAILABLE_DISKS[@]} -eq 0 ]; then
        echo -e "${RED}${BOLD}Error: No suitable internal installation disk detected!${NC}" >&2
        exit 1
    fi

    echo -e "\nAvailable Disks:"
    for i in "${!AVAILABLE_DISKS[@]}"; do
        d="${AVAILABLE_DISKS[$i]}"
        printf "  [%d] %s (%s, %s)\n" "$((i+1))" "$d" "$(lsblk -d -n -o SIZE "$d")" "$(lsblk -d -n -o MODEL "$d")"
    done

    echo ""
    read -rp "Select disk number to install RiOS [1-${#AVAILABLE_DISKS[@]}]: " CHOICE
    if [[ "$CHOICE" =~ ^[0-9]+$ ]] && [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le ${#AVAILABLE_DISKS[@]} ]; then
        TARGET_DISK="${AVAILABLE_DISKS[$((CHOICE-1))]}"
    else
        echo -e "${RED}Invalid selection. Aborting.${NC}" >&2
        exit 1
    fi
fi

# 2. Safety Verification & Confirmation
if [ "$DRY_RUN" -eq 0 ]; then show_disk_details "$TARGET_DISK"; else echo "Simulated Target: $TARGET_DISK"; fi

if [ "$DRY_RUN" -eq 0 ] && ! is_safe_disk "$TARGET_DISK"; then
    echo -e "${RED}${BOLD}Error: Safety check failed for $TARGET_DISK. Aborting.${NC}" >&2
    exit 1
fi

if [ "$NON_INTERACTIVE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
    echo -e "\n${RED}${BOLD}============================================================${NC}"
    echo -e "${RED}${BOLD}                         WARNING!                          ${NC}"
    echo -e "${RED}${BOLD}============================================================${NC}"
    echo -e "You selected: ${BOLD}${TARGET_DISK}${NC}"
    echo -e "ALL DATA ON THIS DISK WILL BE PERMANENTLY ERASED!"
    echo -e "RiOS will format and install onto this device."
    echo -e "${RED}${BOLD}============================================================${NC}"
    read -rp "Type 'YES' (all uppercase) to confirm installation: " CONFIRM
    if [ "$CONFIRM" != "YES" ]; then
        echo -e "${YELLOW}Installation cancelled by user. No changes were made.${NC}"
        exit 0
    fi
fi

# 3. Execution Pipeline
if [ "$DRY_RUN" -eq 1 ]; then
    echo -e "\n${GREEN}[DRY-RUN] Verification of pipeline stages passed:${NC}"
    echo "  1. Partition disk:   $TARGET_DISK"
    echo "  2. Format FS:        ESP (FAT32) + Root (ext4)"
    echo "  3. Mount target:     $TARGET_MOUNT"
    echo "  4. Deploy OS:        Purge live-boot, install kernel & initramfs"
    echo "  5. User setup:       $USERNAME ($FULLNAME)"
    echo "  6. Network setup:    $HOSTNAME"
    echo "  7. Desktop setup:    $DESKTOP_SESSION + first-boot service"
    echo "  8. Bootloader:       GRUB ($BOOT_MODE)"
    echo "  9. Finalize:         fstab by UUID & clean unmount"
    echo -e "\n${GREEN}${BOLD}[✔] Dry-run completed successfully.${NC}"
    exit 0
fi

echo -e "\n${CYAN}${BOLD}[1/8] Partitioning target drive...${NC}"
partition_disk "$TARGET_DISK" "$BOOT_MODE"

echo -e "\n${CYAN}${BOLD}[2/8] Formatting filesystems...${NC}"
format_filesystems "$TARGET_DISK" "$BOOT_MODE"

echo -e "\n${CYAN}${BOLD}[3/8] Mounting target...${NC}"
mount_target "$TARGET_DISK" "$TARGET_MOUNT" "$BOOT_MODE"

echo -e "\n${CYAN}${BOLD}[4/8] Deploying RiOS system files...${NC}"
install_system_files "$TARGET_MOUNT"
purge_live_components "$TARGET_MOUNT"

echo -e "\n${CYAN}${BOLD}[5/8] Configuring user accounts...${NC}"
configure_user "$TARGET_MOUNT" "$USERNAME" "$PASSWORD" "$FULLNAME" "$PASSWORD"

echo -e "\n${CYAN}${BOLD}[6/8] Configuring host & networking...${NC}"
configure_network "$TARGET_MOUNT" "$HOSTNAME" "Asia/Phnom_Penh"

echo -e "\n${CYAN}${BOLD}[7/8] Configuring desktop & services...${NC}"
configure_desktop "$TARGET_MOUNT" "$DESKTOP_SESSION"

echo -e "\n${CYAN}${BOLD}[8/8] Installing bootloader & generating fstab...${NC}"
install_bootloader "$TARGET_DISK" "$TARGET_MOUNT" "$BOOT_MODE"
generate_fstab "$TARGET_DISK" "$TARGET_MOUNT" "$BOOT_MODE"

finish_installation "$TARGET_MOUNT"
