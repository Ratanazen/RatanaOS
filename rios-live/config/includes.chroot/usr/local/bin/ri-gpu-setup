#!/usr/bin/env bash
# ==============================================================================
# RiOS GPU & Hardware Graphics Acceleration Setup (2026)
# Automatically detects GPUs, configures Mesa/Vulkan, and installs NVIDIA/AMD drivers
# ==============================================================================

set -euo pipefail

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║        RiOS Hardware Graphics & GPU Driver Hub           ║"
    echo "║         Vulkan, VA-API, Mesa, Intel, AMD & NVIDIA        ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

usage() {
    print_banner
    echo -e "${BOLD}Usage:${NC} sudo ri-gpu-setup <command>"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  status            Detect GPUs, active drivers, Vulkan & hardware decode"
    echo "  nvidia            Install proprietary NVIDIA drivers & CUDA tools"
    echo "  mesa              Ensure latest Mesa & Vulkan drivers are installed"
    echo "  prime             Configure hybrid graphics offload (NVIDIA + Intel/AMD)"
    echo "  help              Show this help"
    echo ""
    exit 0
}

cmd_status() {
    print_banner
    echo -e "${BOLD}=== Detected Graphics Hardware ===${NC}"
    if command -v lspci >/dev/null 2>&1; then
        lspci -k | grep -A 2 -E "(VGA|3D|Display)" || echo "No PCI graphics detected."
    else
        echo "lspci not installed."
    fi

    echo -e "\n${BOLD}=== Kernel Driver in Use ===${NC}"
    if [ -d /sys/class/drm ]; then
        for card in /sys/class/drm/card[0-9]; do
            if [ -d "$card" ]; then
                local dev_name
                dev_name=$(basename "$card")
                local driver
                driver=$(readlink -f "$card/device/driver" 2>/dev/null | xargs basename 2>/dev/null || echo "Unknown")
                echo -e "  [ ${GREEN}ACTIVE${NC} ] Device ${BOLD}${dev_name}${NC}: Driver ${BOLD}${driver}${NC}"
            fi
        done
    fi

    echo -e "\n${BOLD}=== Vulkan Runtime Support ===${NC}"
    if command -v vulkaninfo >/dev/null 2>&1; then
        local vk_dev
        vk_dev=$(vulkaninfo --summary 2>/dev/null | grep -E "deviceName" | head -n 2 || true)
        if [ -n "$vk_dev" ]; then
            echo -e "  [ ${GREEN}READY${NC} ] Vulkan API functional:\n${vk_dev}"
        else
            echo -e "  [ ${YELLOW}WARN${NC} ] Vulkan installed but no device reported."
        fi
    else
        echo -e "  [ ${YELLOW}MISSING${NC} ] vulkaninfo not installed (install vulkan-tools)."
    fi

    echo -e "\n${BOLD}=== Hardware Video Acceleration (VA-API) ===${NC}"
    if command -v vainfo >/dev/null 2>&1; then
        if vainfo >/dev/null 2>&1; then
            echo -e "  [ ${GREEN}READY${NC} ] VA-API video decode acceleration available."
        else
            echo -e "  [ ${YELLOW}WARN${NC} ] VA-API driver not initialized for current display."
        fi
    else
        echo -e "  [ ${YELLOW}INFO${NC} ] vainfo not installed (install vainfo for video decode checks)."
    fi
    echo ""
}

cmd_nvidia() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${BOLD}Installing Debian Bookworm NVIDIA Proprietary Drivers...${NC}"
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        nvidia-driver \
        nvidia-smi \
        nvidia-vulkan-icd \
        libgl1-nvidia-glvnd-glx \
        firmware-misc-nonfree

    echo -e "\n${GREEN}${BOLD}✔ NVIDIA Drivers installed! Reboot required to load module.${NC}"
}

cmd_mesa() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${BOLD}Configuring Open-Source Mesa & Vulkan Driver Stack...${NC}"
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers \
        mesa-va-drivers \
        mesa-vdpau-drivers \
        libgl1-mesa-dri \
        vulkan-tools \
        vainfo

    echo -e "\n${GREEN}${BOLD}✔ Mesa & Vulkan acceleration stack verified!${NC}"
}

cmd_prime() {
    print_banner
    echo -e "${BOLD}Hybrid Graphics Render Offload Guide:${NC}"
    echo "To launch any application with dedicated NVIDIA GPU offload, run:"
    echo -e "  ${BOLD}__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia <program>${NC}"
    echo ""
    echo "To launch with AMD dedicated GPU offload, run:"
    echo -e "  ${BOLD}DRI_PRIME=1 <program>${NC}"
    echo ""
}

case "${1:-status}" in
    status)
        cmd_status
        ;;
    nvidia)
        cmd_nvidia
        ;;
    mesa)
        cmd_mesa
        ;;
    prime|hybrid)
        cmd_prime
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        ;;
esac
