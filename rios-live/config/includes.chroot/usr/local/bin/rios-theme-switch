#!/usr/bin/env bash
# RiOS Dynamic Theme Switcher
CURRENT=$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || echo "Adwaita-dark")

if [ "$1" = "dark" ] || [ "$CURRENT" = "Adwaita" ]; then
    echo "Switching to RiOS Dark Mode..."
    xfconf-query -c xsettings -p /Net/ThemeName -s "Adwaita-dark"
    xfconf-query -c xfwm4 -p /general/theme -s "Adwaita-dark"
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Papirus-Dark"
elif [ "$1" = "light" ] || [ "$CURRENT" = "Adwaita-dark" ]; then
    echo "Switching to RiOS Light Mode..."
    xfconf-query -c xsettings -p /Net/ThemeName -s "Adwaita"
    xfconf-query -c xfwm4 -p /general/theme -s "Adwaita"
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Papirus-Light"
fi
