#!/usr/bin/env bash
# ==============================================================================
# RiOS Safe USB Flasher (2026)
# Safely writes RiOS Hybrid Live ISO to removable USB drives for real PC install
# Features:
#   - Strict removable drive detection (prevents overwriting internal SSD/NVMe)
#   - Root safety guard
#   - Automatic unmounting
#   - Direct block write with sync & buffer flushing
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

DEFAULT_ISO="${ROOT_DIR}/build/rios-live-amd64.hybrid.iso"
TARGET_DEV=""
ISO_FILE="${DEFAULT_ISO}"
NON_INTERACTIVE=0

print_banner() {
    echo -e "${BLUE}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║               RiOS Safe USB Flasher (2026)              ║"
    echo "║       Prepare Real PC Installation USB Media Safely      ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

usage() {
    print_banner
    echo -e "${BOLD}Usage:${NC} $0 [OPTIONS]"
    echo ""
    echo -e "${BOLD}Options:${NC}"
    echo "  --target <device>    Target USB block device (e.g. /dev/sdb)"
    echo "  --iso <path>         Path to RiOS ISO file (default: build/rios-live-amd64.hybrid.iso)"
    echo "  -y, --yes            Skip interactive confirmation"
    echo "  -h, --help           Show this help"
    echo ""
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --target) TARGET_DEV="$2"; shift 2 ;;
        --iso)    ISO_FILE="$2"; shift 2 ;;
        -y|--yes) NON_INTERACTIVE=1; shift ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

print_banner

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Error: This utility requires root privileges to write to block devices.${NC}"
    echo "Please run: sudo $0 $*"
    exit 1
fi

if [ ! -f "$ISO_FILE" ]; then
    echo -e "${RED}Error: ISO file not found at: ${ISO_FILE}${NC}"
    echo "Run './build.sh' to compile the ISO first."
    exit 1
fi

ISO_SIZE=$(du -h "$ISO_FILE" | cut -f1)
echo -e "Source ISO:  ${BOLD}${ISO_FILE}${NC} (${ISO_SIZE})"

# Enumerate Removable USB Drives
list_usb_drives() {
    lsblk -d -n -o PATH,TRAN,RM,HOTPLUG,SIZE,MODEL 2>/dev/null | while read -r path tran rm hotplug size model; do
        # Accept if transport is USB or marked removable/hotplug
        if [ "$tran" = "usb" ] || [ "$rm" = "1" ] || [ "$hotplug" = "1" ]; then
            # Verify it is not the active root drive
            if ! lsblk -n -o MOUNTPOINT "$path" 2>/dev/null | grep -E '^/$' >/dev/null; then
                echo "$path"
            fi
        fi
    done
}

if [ -z "$TARGET_DEV" ]; then
    mapfile -t USB_DISKS < <(list_usb_drives)
    if [ ${#USB_DISKS[@]} -eq 0 ]; then
        echo -e "\n${YELLOW}No removable USB drives detected!${NC}"
        echo "Please plug in a USB flash drive (8GB+ recommended) and re-run this script."
        exit 1
    fi

    echo -e "\n${BOLD}Detected Removable USB Drives:${NC}"
    for i in "${!USB_DISKS[@]}"; do
        d="${USB_DISKS[$i]}"
        printf "  [%d] %s (%s, %s)\n" "$((i+1))" "$d" "$(lsblk -d -n -o SIZE "$d" 2>/dev/null)" "$(lsblk -d -n -o MODEL "$d" 2>/dev/null || echo 'Generic USB')"
    done

    echo ""
    read -rp "Select USB device number to flash [1-${#USB_DISKS[@]}]: " CHOICE
    if [[ "$CHOICE" =~ ^[0-9]+$ ]] && [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le ${#USB_DISKS[@]} ]; then
        TARGET_DEV="${USB_DISKS[$((CHOICE-1))]}"
    else
        echo -e "${RED}Invalid selection. Aborting.${NC}"
        exit 1
    fi
fi

# Strict Safety Verification
if [ ! -b "$TARGET_DEV" ]; then
    echo -e "${RED}Error: '$TARGET_DEV' is not a valid block device!${NC}"
    exit 1
fi

# Ensure target is not mounted as system root /
if lsblk -n -o MOUNTPOINT "$TARGET_DEV" 2>/dev/null | grep -E '^/$' >/dev/null; then
    echo -e "${RED}${BOLD}CRITICAL ERROR: '$TARGET_DEV' contains the running system root (/)!${NC}"
    echo "Refusing to overwrite active host system."
    exit 1
fi

DEV_SIZE=$(lsblk -d -n -o SIZE "$TARGET_DEV" 2>/dev/null || echo "Unknown")
DEV_MODEL=$(lsblk -d -n -o MODEL "$TARGET_DEV" 2>/dev/null || echo "USB Storage")

echo -e "\n${RED}${BOLD}============================================================${NC}"
echo -e "${RED}${BOLD}                     CAUTION: DATA LOSS                     ${NC}"
echo -e "${RED}${BOLD}============================================================${NC}"
echo -e "Target Drive:    ${BOLD}${TARGET_DEV}${NC} (${DEV_SIZE}, ${DEV_MODEL})"
echo -e "Source ISO:      ${BOLD}${ISO_FILE}${NC}"
echo -e "\nALL PARTITIONS AND DATA ON ${BOLD}${TARGET_DEV}${NC} WILL BE COMPLETELY ERASED!"
echo -e "${RED}${BOLD}============================================================${NC}"

if [ "$NON_INTERACTIVE" -eq 0 ]; then
    read -rp "Type 'YES' (all uppercase) to write RiOS to USB: " CONFIRM
    if [ "$CONFIRM" != "YES" ]; then
        echo -e "${YELLOW}Flashing cancelled by user. No data was modified.${NC}"
        exit 0
    fi
fi

# Unmount any mounted partitions on target
echo -e "\n${CYAN}[1/3] Unmounting existing partitions on ${TARGET_DEV}...${NC}"
for part in $(lsblk -n -o PATH "$TARGET_DEV" 2>/dev/null); do
    if [ "$part" != "$TARGET_DEV" ] && mountpoint -q "$part" 2>/dev/null; then
        umount -f "$part" 2>/dev/null || true
    fi
done

# Perform direct write
echo -e "${CYAN}[2/3] Writing RiOS image to ${TARGET_DEV} (this may take a few minutes)...${NC}"
dd if="$ISO_FILE" of="$TARGET_DEV" bs=4M status=progress oflag=sync conv=fsync

# Flush kernel write buffers
echo -e "${CYAN}[3/3] Syncing filesystem buffers...${NC}"
sync

echo -e "\n${GREEN}${BOLD}============================================================${NC}"
echo -e "${GREEN}${BOLD}      ✔ RiOS USB INSTALLATION MEDIA CREATED SUCCESSFULLY!    ${NC}"
echo -e "${GREEN}${BOLD}============================================================${NC}"
echo -e "You can now boot any physical computer from this USB drive:"
echo -e "  1. Insert USB into target computer"
echo -e "  2. Power on and press boot key (F12, F11, F8, or ESC depending on motherboard)"
echo -e "  3. Select UEFI or Legacy boot entry: RiOS Live"
echo -e "  4. In the live environment, launch '${BOLD}sudo ri-installer${NC}' to install to disk"
echo "============================================================"
echo ""
