#!/usr/bin/env bash
# ==============================================================================
# RiOS Centralized Theme Switcher
# Synchronizes 7 visual themes across Hyprland, Niri, Sway, Waybar,
# Rofi/Wofi, SwayNC, Kitty, Foot, and GTK.
# ==============================================================================

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ri"
THEME_FILE="${CONFIG_DIR}/theme.conf"
THEMES_SYSTEM="/usr/share/ri/themes"
THEMES_LOCAL="${CONFIG_DIR}/themes"

mkdir -p "${CONFIG_DIR}"

list_themes() {
    echo "Available RiOS Themes:"
    echo "  - dark      (Ri Dark - macOS Sequoia Obsidian & Electric Blue)"
    echo "  - light     (Ri Light - Cupertino Clean & Crisp Azure)"
    echo "  - glass     (Ri Glass - Deep Translucency & Ethereal Frost)"
    echo "  - cyber     (Ri Cyber - Neon Synthwave Cyan & Magenta)"
    echo "  - anime     (Ri Anime - Sakura Blossom Pink & Soft Lavender)"
    echo "  - minimal   (Ri Minimal - Monochrome Slate & Clean Gray)"
    echo "  - purple    (Ri Purple - Royal Violet & Lilac Glow)"
}

if [ $# -eq 0 ] || [ "$1" = "list" ] || [ "$1" = "-l" ] || [ "$1" = "--list" ]; then
    list_themes
    exit 0
fi

if [ "$1" = "current" ]; then
    if [ -f "${THEME_FILE}" ]; then
        # shellcheck disable=SC1090
        source "${THEME_FILE}"
        echo "Current theme: ${RATANA_NAME:-$RATANA_THEME}"
    else
        echo "Current theme: ri-dark (default)"
    fi
    exit 0
fi

THEME_ARG="$1"
if [[ "$THEME_ARG" != ri-* ]] && [ "$THEME_ARG" != "apply" ]; then
    THEME_NAME="ri-${THEME_ARG}"
else
    THEME_NAME="${THEME_ARG}"
fi

# Find theme source definition
SRC_THEME=""
if [ "$THEME_NAME" != "apply" ]; then
    for candidate in \
        "${THEMES_LOCAL}/${THEME_NAME}/theme.conf" \
        "${THEMES_SYSTEM}/${THEME_NAME}/theme.conf" \
        "/home/reny/Documents/OS/themes/${THEME_NAME}/theme.conf" \
        "${HOME}/.config/ri/themes/${THEME_NAME}.conf"; do
        if [ -f "$candidate" ]; then
            SRC_THEME="$candidate"
            break
        fi
    done

    if [ -z "$SRC_THEME" ]; then
        echo "Error: Theme '${THEME_ARG}' not found." >&2
        list_themes
        exit 1
    fi

    cp -f "$SRC_THEME" "${THEME_FILE}"
fi

if [ ! -f "${THEME_FILE}" ]; then
    echo "Error: Theme configuration '${THEME_FILE}' not found." >&2
    exit 1
fi

# shellcheck disable=SC1090
source "${THEME_FILE}"

echo "==> Applying RiOS Theme: ${RATANA_NAME} (${RATANA_THEME})..."

# 1. Update Waybar Dynamic Theme CSS
WAYBAR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
mkdir -p "${WAYBAR_DIR}"
cat <<EOF > "${WAYBAR_DIR}/theme.css"
/* Auto-generated by ri-theme — DO NOT EDIT DIRECTLY */
@define-color accent ${RATANA_ACCENT};
@define-color accent_alt ${RATANA_ACCENT_ALT};
@define-color bg ${RATANA_BACKGROUND};
@define-color bg_alt ${RATANA_BACKGROUND_ALT};
@define-color fg ${RATANA_FOREGROUND};
@define-color muted ${RATANA_MUTED};
@define-color border ${RATANA_BORDER};
@define-color border_active ${RATANA_BORDER_ACTIVE};
@define-color glass ${RATANA_GLASS};
@define-color transparent ${RATANA_TRANSPARENT};
@define-color radius ${RATANA_RADIUS}px;
@define-color gap ${RATANA_GAP}px;
@define-color blur ${RATANA_BLUR}px;
EOF

# 2. Update Wofi Theme CSS
WOFI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wofi"
mkdir -p "${WOFI_DIR}"
cat <<EOF > "${WOFI_DIR}/theme.css"
/* Auto-generated by ri-theme */
@define-color accent ${RATANA_ACCENT};
@define-color bg ${RATANA_BACKGROUND};
@define-color bg_alt ${RATANA_BACKGROUND_ALT};
@define-color fg ${RATANA_FOREGROUND};
@define-color muted ${RATANA_MUTED};
@define-color border ${RATANA_BORDER_ACTIVE};
@define-color glass ${RATANA_GLASS};
@define-color radius ${RATANA_RADIUS}px;
EOF

# 3. Update SwayNC Theme CSS
SWAYNC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/swaync"
mkdir -p "${SWAYNC_DIR}"
cat <<EOF > "${SWAYNC_DIR}/theme.css"
/* Auto-generated by ri-theme */
@define-color cc-bg ${RATANA_GLASS};
@define-color noti-bg ${RATANA_BACKGROUND_ALT};
@define-color noti-border ${RATANA_BORDER};
@define-color noti-border-active ${RATANA_BORDER_ACTIVE};
@define-color text-color ${RATANA_FOREGROUND};
@define-color text-color-disabled ${RATANA_MUTED};
@define-color bg-selected ${RATANA_ACCENT};
@define-color radius ${RATANA_RADIUS}px;
EOF

# 4. Update Kitty Terminal Theme
KITTY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
mkdir -p "${KITTY_DIR}"
cat <<EOF > "${KITTY_DIR}/theme.conf"
# Auto-generated by ri-theme
foreground ${RATANA_FOREGROUND}
background ${RATANA_BACKGROUND}
background_opacity ${RATANA_OPACITY}
cursor ${RATANA_ACCENT}
selection_background ${RATANA_ACCENT}
selection_foreground ${RATANA_BACKGROUND}
url_color ${RATANA_ACCENT_ALT}
active_border_color ${RATANA_ACCENT}
inactive_border_color ${RATANA_BORDER}
EOF

# 5. Update Foot Terminal Theme
FOOT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foot"
mkdir -p "${FOOT_DIR}"
cat <<EOF > "${FOOT_DIR}/theme.ini"
# Auto-generated by ri-theme
[colors]
alpha=${RATANA_OPACITY}
foreground=${RATANA_FOREGROUND:1}
background=${RATANA_BACKGROUND:1}
regular0=${RATANA_BACKGROUND_ALT:1}
regular1=f7768e
regular2=9ece6a
regular3=e0af68
regular4=${RATANA_ACCENT:1}
regular5=${RATANA_ACCENT_ALT:1}
regular6=7dcfff
regular7=${RATANA_FOREGROUND:1}
EOF

# 6. Apply GTK Settings via gsettings if available
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface gtk-theme "${RATANA_GTK_THEME}" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "${RATANA_ICON_THEME}" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme "${RATANA_CURSOR_THEME}" 2>/dev/null || true
    if [ "${RATANA_THEME}" = "ri-light" ]; then
        gsettings set org.gnome.desktop.interface color-scheme 'default' 2>/dev/null || true
    else
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    fi
fi

# 7. Apply Wallpaper
if command -v ri-wallpaper >/dev/null 2>&1 && [ -f "${RATANA_WALLPAPER:-}" ]; then
    ri-wallpaper set "${RATANA_WALLPAPER}" 2>/dev/null || true
elif [ -f "${RATANA_WALLPAPER:-}" ]; then
    if command -v swww >/dev/null 2>&1 && pgrep -x swww-daemon >/dev/null 2>&1; then
        swww img "${RATANA_WALLPAPER}" --transition-type wipe --transition-fps 60 2>/dev/null || true
    elif command -v swaybg >/dev/null 2>&1; then
        pkill swaybg 2>/dev/null || true
        swaybg -i "${RATANA_WALLPAPER}" -m fill &
    fi
fi

# 8. Signal Live Desktop Daemons to Reload
if pgrep -x waybar >/dev/null 2>&1; then
    pkill -SIGUSR2 waybar 2>/dev/null || true
fi
if command -v swaync-client >/dev/null 2>&1 && pgrep -x swaync >/dev/null 2>&1; then
    swaync-client --reload-css 2>/dev/null || true
fi
if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
    hyprctl reload 2>/dev/null || true
fi
if command -v swaymsg >/dev/null 2>&1 && pgrep -x sway >/dev/null 2>&1; then
    swaymsg reload 2>/dev/null || true
fi
if command -v niri >/dev/null 2>&1 && pgrep -x niri >/dev/null 2>&1; then
    niri msg action reload-config 2>/dev/null || true
fi

echo "✅ RiOS Theme '${RATANA_NAME}' applied successfully."
EOF
chmod +x /home/reny/Documents/OS/scripts/ri-theme
