[Unit]
Description=RiOS First-Boot System Provisioning Service
Documentation=https://github.com/Ratanazen/RatanaOS
After=network.target local-fs.target
Before=display-manager.service
ConditionPathExists=!/var/lib/rios/.first-boot-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ri-first-boot
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
