#include <tunables/global>

profile ratana-installer /usr/bin/ratana-installer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/dbus-session>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  capability chown,
  capability dac_override,
  capability fowner,
  capability setgid,
  capability setuid,
  capability sys_admin,

  network inet stream,
  network inet6 stream,
  network netlink raw,

  /usr/bin/ratana-installer mr,
  /usr/lib/** r,
  /etc/** r,
  /run/** rw,
  /tmp/** rw,
  /var/log/ratana-installer/** rwk,
  /var/tmp/** rw,

  /dev/null rw,
  /dev/tty rw,
  /dev/urandom r,

  /proc/** r,
  /sys/firmware/efi/** r,
  /sys/block/** r,
  /sys/class/block/** r,

  /usr/sbin/blkid ixr,
  /usr/sbin/parted ixr,
  /usr/sbin/mkfs.ext4 ixr,
  /usr/sbin/mkswap ixr,
  /usr/bin/lsblk ixr,
  /usr/bin/mount ixr,
  /usr/bin/umount ixr,

  deny /home/** wl,
  deny /root/** wl,
  deny @{PROC}/sysrq-trigger rwklx,
}

