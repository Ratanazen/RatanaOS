/**
 * RatanaOS Rofi Modern Spotlight Theme
 **/

configuration {
    modi: "drun,run,filebrowser,window";
    font: "JetBrains Mono Nerd Font 13";
    show-icons: true;
    icon-theme: "WhiteSur-dark";
    display-drun: " ";
    display-run: " ";
    display-filebrowser: " ";
    display-window: " ";
    drun-display-format: "{name}";
    hover-select: true;
}

@theme "/dev/null"

* {
    bg: #16161Eff;
    bg-alt: #1F2335ff;
    fg: #C0CAF5ff;
    accent: #0A84FFff;
    muted: #565F89ff;
    border-col: #0A84FFff;
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    width: 640px;
    height: 420px;
    border: 2px solid;
    border-color: @border-col;
    border-radius: 16px;
    background-color: @bg;
}

mainbox {
    padding: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
    margin: 0 0 12px 0;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Search applications, files, commands...";
    placeholder-color: @muted;
}

listview {
    lines: 7;
    columns: 1;
    cycle: true;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 10px;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 28px;
    padding: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
}

element selected {
    background-color: @accent;
    text-color: #ffffff;
}
