{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/pixmaps/ratana-logo.png",
        "type": "kitty-direct",
        "width": 24,
        "height": 12
    },
    "display": {
        "separator": " ❯ "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "format": "RatanaOS 1.0 (macOS Sequoia 2026 M4 Pro Edition)"
        },
        {
            "type": "host",
            "format": "Apple M4 Pro Silicon Architecture (x86_64 Optimized)"
        },
        "kernel",
        "uptime",
        {
            "type": "de",
            "format": "Hyprland / GNOME 43+ / KDE Plasma 5.27"
        },
        {
            "type": "wm",
            "format": "Hyprland (M4 Pro Fluid Compositor)"
        },
        {
            "type": "theme",
            "format": "WhiteSur-Dark (macOS Tahoe/Sequoia)"
        },
        {
            "type": "icons",
            "format": "WhiteSur-dark (Retina Pro)"
        },
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}