{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": ["custom/apple", "hyprland/window", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "network", "battery", "custom/controlcenter"],

    "custom/apple": {
        "format": "  RatanaOS",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
    "hyprland/window": {
        "format": "Finder",
        "separate-outputs": true
    },
    "sway/window": {
        "format": "Finder"
    },
    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "M4 Pro: {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "RAM: {percentage}%",
        "interval": 2
    },
    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔇 Muted",
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "⚠ Offline",
        "on-click": "gnome-control-center wifi"
    },
    "battery": {
        "format": "🔋 {capacity}%"
    },
    "custom/controlcenter": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "gnome-session-quit"
    }
}