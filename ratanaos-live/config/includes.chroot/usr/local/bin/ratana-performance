#!/usr/bin/env bash
# ==============================================================================
# RatanaOS Performance & Animation Tuning Engine
# Modes: low (ultra-light), balanced (smooth), beautiful (full glass blur & 120Hz)
# ==============================================================================

set -euo pipefail

MODE="${1:-balanced}"

case "$MODE" in
    low|lite|performance)
        echo "==> Applying RatanaOS Low-End / Battery Saver Profile..."
        if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
            hyprctl keyword decoration:blur:enabled false
            hyprctl keyword decoration:drop_shadow false
            hyprctl keyword animations:enabled false
        fi
        echo "Low-end mode applied: Blur disabled, shadows disabled, animations disabled."
        ;;

    balanced)
        echo "==> Applying RatanaOS Balanced Profile..."
        if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
            hyprctl keyword decoration:blur:enabled true
            hyprctl keyword decoration:blur:passes 1
            hyprctl keyword decoration:blur:size 5
            hyprctl keyword decoration:drop_shadow true
            hyprctl keyword decoration:shadow_range 12
            hyprctl keyword animations:enabled true
        fi
        echo "Balanced mode applied: Light blur, standard shadows, smooth animations."
        ;;

    beautiful|high|full)
        echo "==> Applying RatanaOS Beautiful / 120Hz Acrylic Profile..."
        if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
            hyprctl keyword decoration:blur:enabled true
            hyprctl keyword decoration:blur:passes 3
            hyprctl keyword decoration:blur:size 10
            hyprctl keyword decoration:drop_shadow true
            hyprctl keyword decoration:shadow_range 24
            hyprctl keyword animations:enabled true
        fi
        echo "Beautiful mode applied: 3-pass acrylic blur, ambient drop shadows, 120Hz ProMotion curves."
        ;;

    *)
        echo "Usage: ratana-performance [low | balanced | beautiful]" >&2
        exit 1
        ;;
esac
