#!/usr/bin/env bash
mkdir -p "$HOME/Pictures/Screenshots"
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
TARGET="$HOME/Pictures/Screenshots/Screen_Shot_${TIMESTAMP}.png"

if [ "$1" = "area" ]; then
    grim -g "$(slurp -d -c 00BBF9 -b 00000044)" "$TARGET"
else
    grim "$TARGET"
fi

if [ -f "$TARGET" ]; then
    wl-copy < "$TARGET"
    notify-send "Screenshot Captured" "Saved to ~/Pictures/Screenshots and copied to clipboard." -i "$TARGET"
fi
