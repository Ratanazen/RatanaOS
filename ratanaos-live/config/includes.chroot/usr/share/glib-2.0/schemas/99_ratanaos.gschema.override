[org.gnome.desktop.interface]
gtk-theme='WhiteSur-Dark'
icon-theme='WhiteSur-dark'
cursor-theme='WhiteSur-cursors'
color-scheme='prefer-dark'
font-name='Cantarell 11'
document-font-name='Cantarell 11'
monospace-font-name='Monospace 11'

[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:'
theme='WhiteSur-Dark'

[org.gnome.mutter]
center-new-windows=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/ratanaos/ratanaos-sequoia-dark.png'
picture-uri-dark='file:///usr/share/backgrounds/ratanaos/ratanaos-sequoia-dark.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/ratanaos/ratanaos-sequoia-dark.png'

[org.gnome.shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'ubuntu-appindicators@ubuntu.com']
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'kitty.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.TextEditor.desktop', 'gnome-control-center.desktop', 'calamares.desktop']

[org.gnome.shell.extensions.user-theme]
name='WhiteSur-Dark'

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
dash-max-icon-size=52
transparency-mode='DYNAMIC'
custom-theme-shrink=true
show-trash=true
show-mounts=true
apply-custom-theme=true
running-indicator-style='DOTS'
custom-background-color=true
background-color='rgba(25,25,30,0.55)'
