# ==============================================================================
# RatanaOS Secure Boot, Bootloader & Disk Support for Real Hardware
# ==============================================================================

# UEFI Secure Boot & Standard UEFI bootloaders
shim-signed
grub-efi-amd64
grub-efi-amd64-bin
grub-efi-amd64-signed
efibootmgr

# Legacy BIOS / MBR bootloader
grub-pc
grub-pc-bin
grub2-common

# Dual-boot multi-OS auto-detection (Windows / Linux)
os-prober

# Partitioning and filesystem utilities for EFI/MBR disks
dosfstools
mtools
parted
gdisk

# LUKS disk encryption & LVM tooling
cryptsetup
cryptsetup-initramfs
lvm2
