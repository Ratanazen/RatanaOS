#!/bin/sh
set -e
echo "==> Setting RatanaOS macOS Tahoe wallpaper and branding defaults..."
mkdir -p /usr/share/images/desktop-base /usr/share/backgrounds/ratanaos

cp -f /usr/share/backgrounds/ratanaos/ratanaos-tahoe-blue.png /usr/share/images/desktop-base/default 2>/dev/null || true
cp -f /usr/share/backgrounds/ratanaos/ratanaos-tahoe-blue.png /usr/share/images/desktop-base/desktop-background 2>/dev/null || true
cp -f /usr/share/backgrounds/ratanaos/ratanaos-tahoe-blue.png /usr/share/images/desktop-base/login-background.svg 2>/dev/null || true
cp -f /usr/share/backgrounds/ratanaos/ratanaos-tahoe-blue.png /usr/share/backgrounds/ratanaos/ratanaos-default.png 2>/dev/null || true

# Update GTK icon caches
for theme in WhiteSur WhiteSur-dark WhiteSur-light hicolor; do
    if [ -d "/usr/share/icons/$theme" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "/usr/share/icons/$theme" 2>/dev/null || true
    fi
done


