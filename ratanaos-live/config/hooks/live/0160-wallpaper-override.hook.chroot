#!/bin/sh
set -e
echo "==> Setting RatanaOS macOS Sequoia wallpaper and branding defaults..."
mkdir -p /usr/share/images/desktop-base /usr/share/backgrounds/ratanaos /usr/share/backgrounds/gnome

WALLPAPER="/usr/share/backgrounds/ratanaos/ratanaos-sequoia-dark.png"

if [ -f "$WALLPAPER" ]; then
    cp -f "$WALLPAPER" /usr/share/images/desktop-base/default 2>/dev/null || true
    cp -f "$WALLPAPER" /usr/share/images/desktop-base/desktop-background 2>/dev/null || true
    cp -f "$WALLPAPER" /usr/share/images/desktop-base/login-background.svg 2>/dev/null || true
    cp -f "$WALLPAPER" /usr/share/images/desktop-base/desktop-background.xml 2>/dev/null || true
    cp -f "$WALLPAPER" /usr/share/backgrounds/gnome/adwaita-d.jxl 2>/dev/null || true
    cp -f "$WALLPAPER" /usr/share/backgrounds/gnome/adwaita-l.jxl 2>/dev/null || true
    cp -f "$WALLPAPER" /usr/share/backgrounds/ratanaos/ratanaos-default.png 2>/dev/null || true
fi

# Update GTK icon caches
for theme in WhiteSur WhiteSur-dark WhiteSur-light hicolor; do
    if [ -d "/usr/share/icons/$theme" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "/usr/share/icons/$theme" 2>/dev/null || true
    fi
done
