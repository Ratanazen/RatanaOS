#!/bin/bash
# ============================================================================
# ratanaos-network — RatanaOS Network Management & Analysis
# ============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

banner() {
    echo -e "${CYAN}${BOLD}  RatanaOS Network Manager${NC}"
    echo ""
}

cmd_status() {
    banner
    echo -e "${BOLD}  ── Interfaces ──${NC}"
    ip -br addr 2>/dev/null || ifconfig 2>/dev/null
    echo ""
    echo -e "${BOLD}  ── Routing Table ──${NC}"
    ip route 2>/dev/null | head -10
    echo ""
    echo -e "${BOLD}  ── DNS ──${NC}"
    cat /etc/resolv.conf 2>/dev/null | grep nameserver
    echo ""
    echo -e "${BOLD}  ── Connections ──${NC}"
    ss -tunp 2>/dev/null | head -15
    echo ""
    echo -e "${BOLD}  ── Public IP ──${NC}"
    curl -s --max-time 3 ifconfig.me 2>/dev/null || echo "N/A"
    echo ""
}

cmd_monitor() {
    banner
    echo -e "${CYAN}[*] Live network monitoring (Ctrl+C to stop)...${NC}"
    if command -v iftop &>/dev/null; then
        iftop
    elif command -v nethogs &>/dev/null; then
        nethogs
    else
        watch -n 1 'ss -tunp | head -30'
    fi
}

cmd_capture() {
    local iface="${1:-any}"
    local outfile="${HOME}/.ratanaos/captures/capture_$(date +%Y%m%d_%H%M%S).pcap"
    mkdir -p "$(dirname $outfile)"

    banner
    echo -e "${CYAN}[*] Capturing on ${iface} → ${outfile}${NC}"
    echo -e "${DIM}Press Ctrl+C to stop${NC}"

    if command -v tcpdump &>/dev/null; then
        tcpdump -i "$iface" -w "$outfile" -v
    else
        echo -e "${RED}[!] tcpdump not found. Install: ratapkg install tcpdump${NC}"
    fi
}

cmd_sniff() {
    local iface="${1:-any}"

    banner
    echo -e "${RED}[*] Sniffing packets on ${iface}...${NC}"
    echo -e "${DIM}Press Ctrl+C to stop${NC}"

    if command -v tcpdump &>/dev/null; then
        tcpdump -i "$iface" -A -n -s0 | head -500
    else
        echo -e "${RED}[!] tcpdump required. Install: ratapkg install tcpdump${NC}"
    fi
}

cmd_wifi() {
    banner
    echo -e "${BOLD}  ── Wireless Interfaces ──${NC}"
    iwconfig 2>/dev/null || echo "  No wireless interfaces"
    echo ""
    echo -e "${BOLD}  ── Available Networks ──${NC}"
    if command -v nmcli &>/dev/null; then
        nmcli dev wifi list 2>/dev/null
    elif command -v iwlist &>/dev/null; then
        iwlist scan 2>/dev/null | grep -E "ESSID|Signal|Encryption"
    else
        echo "  nmcli/iwlist not available"
    fi
}

cmd_tunnel() {
    local lport="${1:?Usage: ratanaos-network tunnel <local-port> <remote-host> <remote-port>}"
    local rhost="${2:?Missing remote host}"
    local rport="${3:?Missing remote port}"

    banner
    echo -e "${CYAN}[*] SSH tunnel: localhost:${lport} → ${rhost}:${rport}${NC}"
    ssh -L "${lport}:localhost:${rport}" "$rhost" -N -f
    echo -e "${GREEN}[✓] Tunnel established${NC}"
}

cmd_proxy() {
    local port="${1:-9050}"

    banner
    echo -e "${CYAN}[*] Starting SOCKS proxy on port ${port}...${NC}"
    if command -v tor &>/dev/null; then
        echo -e "${DIM}Using Tor as SOCKS5 proxy${NC}"
        tor --SocksPort "$port" &
        echo -e "${GREEN}[✓] Tor SOCKS proxy running on port ${port}${NC}"
        echo -e "${DIM}Configure: export ALL_PROXY=socks5://127.0.0.1:${port}${NC}"
    elif command -v ssh &>/dev/null; then
        echo -e "${DIM}Use SSH: ssh -D ${port} user@server${NC}"
    fi
}

case "${1:-help}" in
    status)  cmd_status ;;
    monitor) cmd_monitor ;;
    capture) shift; cmd_capture "$@" ;;
    sniff)   shift; cmd_sniff "$@" ;;
    wifi)    cmd_wifi ;;
    tunnel)  shift; cmd_tunnel "$@" ;;
    proxy)   shift; cmd_proxy "$@" ;;
    *)
        banner
        echo -e "  ${BOLD}Usage:${NC} ratanaos-network <command>"
        echo ""
        echo "    status       Show network status"
        echo "    monitor      Live network monitoring"
        echo "    capture [iface]  Packet capture to PCAP"
        echo "    sniff   [iface]  Live packet sniffing"
        echo "    wifi         Wireless network info"
        echo "    tunnel <lport> <rhost> <rport>  SSH tunnel"
        echo "    proxy  [port]    Start SOCKS proxy"
        echo ""
        ;;
esac
