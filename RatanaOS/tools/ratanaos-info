#!/bin/bash
# ============================================================================
# ratanaos-info — RatanaOS System Information (Security Edition)
# ============================================================================

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Get system info
OS_NAME="RatanaOS"
OS_VERSION="${RATANAOS_VERSION:-1.0.0}"
OS_CODENAME="${RATANAOS_CODENAME:-Angkor}"
KERNEL="$(uname -r)"
ARCH="$(uname -m)"
HOSTNAME="$(hostname)"
UPTIME="$(uptime -p 2>/dev/null | sed 's/up //' || echo 'N/A')"
CPU="$(lscpu 2>/dev/null | grep 'Model name' | sed 's/Model name: *//' | head -1 || echo 'N/A')"
CPU_CORES="$(nproc 2>/dev/null || echo 'N/A')"
MEM_TOTAL="$(free -h 2>/dev/null | awk '/Mem:/ {print $2}' || echo 'N/A')"
MEM_USED="$(free -h 2>/dev/null | awk '/Mem:/ {print $3}' || echo 'N/A')"
DISK_TOTAL="$(df -h / 2>/dev/null | awk 'NR==2 {print $2}' || echo 'N/A')"
DISK_USED="$(df -h / 2>/dev/null | awk 'NR==2 {print $3}' || echo 'N/A')"
SHELL_NAME="$(basename ${SHELL:-/bin/bash})"
PKG_COUNT="$(dpkg -l 2>/dev/null | grep '^ii' | wc -l || echo '0')"
IP_ADDR="$(ip -4 addr show 2>/dev/null | grep -oP 'inet \K[\d.]+' | grep -v '127.0.0.1' | head -1 || echo 'N/A')"
PUBLIC_IP="$(curl -s --max-time 3 ifconfig.me 2>/dev/null || echo 'N/A')"
MAC_ADDR="$(ip link 2>/dev/null | grep -A1 'state UP' | grep ether | awk '{print $2}' | head -1 || echo 'N/A')"

# Security status
FIREWALL="$(systemctl is-active ufw 2>/dev/null || systemctl is-active iptables 2>/dev/null || echo 'inactive')"
SSH_STATUS="$(systemctl is-active sshd 2>/dev/null || systemctl is-active ssh 2>/dev/null || echo 'inactive')"
FAIL2BAN="$(systemctl is-active fail2ban 2>/dev/null || echo 'inactive')"
USERS_LOGGED="$(who 2>/dev/null | wc -l || echo '0')"
OPEN_PORTS="$(ss -tlnp 2>/dev/null | tail -n+2 | wc -l || echo '0')"

# Count security tools
SEC_TOOLS=0
for tool in nmap wireshark tcpdump metasploit sqlmap hydra john hashcat aircrack-ng burpsuite nikto gobuster radare2; do
    command -v "$tool" &>/dev/null && ((SEC_TOOLS++))
done

echo -e ""
echo -e "${RED}  ██████╗  █████╗ ████████╗ █████╗ ███╗   ██╗ █████╗  ██████╗ ███████╗${NC}"
echo -e "${RED}  ██╔══██╗██╔══██╗╚══██╔══╝██╔══██╗████╗  ██║██╔══██╗██╔═══██╗██╔════╝${NC}"
echo -e "${RED}  ██████╔╝███████║   ██║   ███████║██╔██╗ ██║███████║██║   ██║███████╗${NC}"
echo -e "${RED}  ██╔══██╗██╔══██║   ██║   ██╔══██║██║╚██╗██║██╔══██║██║   ██║╚════██║${NC}"
echo -e "${RED}  ██║  ██║██║  ██║   ██║   ██║  ██║██║ ╚████║██║  ██║╚██████╔╝███████║${NC}"
echo -e "${RED}  ╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝${NC}"
echo -e "${DIM}  Security & Server Operating System — v${OS_VERSION} (${OS_CODENAME})${NC}"
echo -e ""
echo -e "${BOLD}  ── System ─────────────────────────────────────────${NC}"
echo -e "  ${CYAN}OS${NC}        ${OS_NAME} ${OS_VERSION} (${OS_CODENAME})"
echo -e "  ${CYAN}Kernel${NC}    ${KERNEL}"
echo -e "  ${CYAN}Arch${NC}      ${ARCH}"
echo -e "  ${CYAN}Hostname${NC}  ${HOSTNAME}"
echo -e "  ${CYAN}Uptime${NC}    ${UPTIME}"
echo -e "  ${CYAN}Shell${NC}     ${SHELL_NAME}"
echo -e "  ${CYAN}Packages${NC}  ${PKG_COUNT} (dpkg)"
echo -e ""
echo -e "${BOLD}  ── Hardware ───────────────────────────────────────${NC}"
echo -e "  ${CYAN}CPU${NC}       ${CPU}"
echo -e "  ${CYAN}Cores${NC}     ${CPU_CORES}"
echo -e "  ${CYAN}Memory${NC}    ${MEM_USED} / ${MEM_TOTAL}"
echo -e "  ${CYAN}Disk${NC}      ${DISK_USED} / ${DISK_TOTAL}"
echo -e ""
echo -e "${BOLD}  ── Network ────────────────────────────────────────${NC}"
echo -e "  ${CYAN}Local IP${NC}  ${IP_ADDR}"
echo -e "  ${CYAN}Public IP${NC} ${PUBLIC_IP}"
echo -e "  ${CYAN}MAC${NC}       ${MAC_ADDR}"
echo -e "  ${CYAN}Ports${NC}     ${OPEN_PORTS} listening"
echo -e ""
echo -e "${BOLD}  ── Security ───────────────────────────────────────${NC}"
if [[ "$FIREWALL" == "active" ]]; then
    echo -e "  ${CYAN}Firewall${NC}  ${GREEN}● Active${NC}"
else
    echo -e "  ${CYAN}Firewall${NC}  ${RED}● Inactive${NC}"
fi
if [[ "$SSH_STATUS" == "active" ]]; then
    echo -e "  ${CYAN}SSH${NC}       ${GREEN}● Active${NC}"
else
    echo -e "  ${CYAN}SSH${NC}       ${DIM}○ Inactive${NC}"
fi
if [[ "$FAIL2BAN" == "active" ]]; then
    echo -e "  ${CYAN}Fail2Ban${NC}  ${GREEN}● Active${NC}"
else
    echo -e "  ${CYAN}Fail2Ban${NC}  ${DIM}○ Inactive${NC}"
fi
echo -e "  ${CYAN}Users${NC}     ${USERS_LOGGED} logged in"
echo -e "  ${CYAN}Arsenal${NC}   ${SEC_TOOLS} security tools installed"
echo -e ""
