#!/bin/bash
# ratanaos-services — Service management wrapper
set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

cmd_list() {
    echo -e "\n${BOLD}${CYAN}  RatanaOS Service Manager${NC}\n"
    echo -e "${BOLD}  ── Active Services ──${NC}"
    systemctl list-units --type=service --state=running 2>/dev/null | head -20 | sed 's/^/  /'
    echo ""
    echo -e "${BOLD}  ── Security Services ──${NC}"
    for svc in sshd ssh fail2ban ufw iptables tor nginx apache2 postgresql mariadb redis docker; do
        local status
        status="$(systemctl is-active $svc 2>/dev/null || echo 'not-found')"
        case "$status" in
            active)    echo -e "  ${GREEN}● ${svc}${NC} — running" ;;
            inactive)  echo -e "  ${YELLOW}○ ${svc}${NC} — stopped" ;;
            *)         echo -e "  ${DIM}· ${svc}${NC} — not installed" ;;
        esac
    done
    echo ""
}

cmd_start()   { sudo systemctl start "$@" && echo -e "${GREEN}[✓] Started: $*${NC}"; }
cmd_stop()    { sudo systemctl stop "$@" && echo -e "${YELLOW}[✓] Stopped: $*${NC}"; }
cmd_restart() { sudo systemctl restart "$@" && echo -e "${GREEN}[✓] Restarted: $*${NC}"; }
cmd_enable()  { sudo systemctl enable "$@" && echo -e "${GREEN}[✓] Enabled: $*${NC}"; }
cmd_disable() { sudo systemctl disable "$@" && echo -e "${YELLOW}[✓] Disabled: $*${NC}"; }
cmd_status()  { systemctl status "$@"; }

case "${1:-list}" in
    list)    cmd_list ;;
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    enable)  shift; cmd_enable "$@" ;;
    disable) shift; cmd_disable "$@" ;;
    status)  shift; cmd_status "$@" ;;
    *)
        echo "Usage: ratanaos-services <list|start|stop|restart|enable|disable|status> [service]"
        ;;
esac
