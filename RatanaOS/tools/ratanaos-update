#!/bin/bash
# ratanaos-update — System update wrapper
set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[!] Run with sudo${NC}"
    exit 1
fi

echo -e "${CYAN}${BOLD}  RatanaOS System Update${NC}"
echo ""
echo -e "${CYAN}[1/3]${NC} Updating package database..."
apt-get update -qq
echo -e "${CYAN}[2/3]${NC} Upgrading packages..."
apt-get upgrade -y
echo -e "${CYAN}[3/3]${NC} Cleaning up..."
apt-get autoremove -y 2>/dev/null
apt-get autoclean -y 2>/dev/null
echo ""
echo -e "${GREEN}[✓] RatanaOS is up to date!${NC}"
