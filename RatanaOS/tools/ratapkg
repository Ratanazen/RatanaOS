#!/bin/bash
# ============================================================================
# ratapkg — RatanaOS Package Manager
# ============================================================================
# Wraps apt/dpkg with RatanaOS branding and extended security-tool management.
# ============================================================================

set -euo pipefail

VERSION="1.0.0"
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

banner() {
    echo -e "${CYAN}${BOLD}┌─────────────────────────────────────────────┐${NC}"
    echo -e "${CYAN}${BOLD}│  ratapkg — RatanaOS Package Manager v${VERSION}  │${NC}"
    echo -e "${CYAN}${BOLD}└─────────────────────────────────────────────┘${NC}"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] This operation requires root. Run with sudo.${NC}"
        exit 1
    fi
}

# Security tool categories
CATEGORY_RECON="nmap masscan amass subfinder httprobe whatweb wafw00f dnsenum dnsrecon fierce"
CATEGORY_EXPLOIT="metasploit-framework exploitdb searchsploit"
CATEGORY_WEBAPP="sqlmap nikto gobuster dirb wpscan zaproxy burpsuite"
CATEGORY_WIRELESS="aircrack-ng kismet wifite reaver bully"
CATEGORY_PASSWORD="john hashcat hydra medusa cewl crunch wordlists"
CATEGORY_NETWORK="wireshark tcpdump netcat-openbsd socat proxychains4 tor ngrep ettercap-text-only arpwatch"
CATEGORY_FORENSICS="binwalk foremost volatility3 autopsy sleuthkit dc3dd"
CATEGORY_REVERSE="radare2 ghidra gdb ltrace strace"
CATEGORY_CRYPTO="openssl gnupg2 hashid hash-identifier"
CATEGORY_SOCIAL="set maltego theharvester recon-ng"
CATEGORY_SERVER="openssh-server nginx apache2 mariadb-server postgresql redis-server docker.io fail2ban ufw iptables"

cmd_install() {
    check_root
    echo -e "${CYAN}[*] Installing: $*${NC}"
    apt-get install -y "$@"
    echo -e "${GREEN}[✓] Installation complete${NC}"
}

cmd_remove() {
    check_root
    echo -e "${YELLOW}[*] Removing: $*${NC}"
    apt-get remove -y "$@"
    echo -e "${GREEN}[✓] Removal complete${NC}"
}

cmd_update() {
    check_root
    echo -e "${CYAN}[*] Updating RatanaOS package database...${NC}"
    apt-get update -qq
    echo -e "${GREEN}[✓] Package database updated${NC}"
}

cmd_upgrade() {
    check_root
    echo -e "${CYAN}[*] Upgrading all packages...${NC}"
    apt-get upgrade -y
    echo -e "${GREEN}[✓] System upgraded${NC}"
}

cmd_search() {
    echo -e "${CYAN}[*] Searching for: $*${NC}"
    apt-cache search "$@" | head -30
}

cmd_list() {
    echo -e "${CYAN}[*] Installed packages:${NC}"
    dpkg -l | grep '^ii' | awk '{printf "  %-35s %s\n", $2, $3}'
}

cmd_info() {
    apt-cache show "$@" 2>/dev/null || dpkg -s "$@" 2>/dev/null
}

cmd_arsenal() {
    echo -e "\n${BOLD}${CYAN}╔═══════════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║        RatanaOS Security Arsenal                  ║${NC}"
    echo -e "${BOLD}${CYAN}╚═══════════════════════════════════════════════════╝${NC}\n"

    echo -e "${BOLD}  Category            Tool Count   Status${NC}"
    echo -e "  ─────────────────── ──────────── ──────"
    
    local categories=("recon:Reconnaissance" "exploit:Exploitation" "webapp:Web Application"
                      "wireless:Wireless" "password:Password" "network:Network Analysis"
                      "forensics:Forensics" "reverse:Reverse Engineering" "crypto:Cryptography"
                      "server:Server Infrastructure")

    for cat_entry in "${categories[@]}"; do
        local cat_id="${cat_entry%%:*}"
        local cat_name="${cat_entry#*:}"
        local var_name="CATEGORY_${cat_id^^}"
        local tools="${!var_name}"
        local total=0
        local installed=0
        for tool in $tools; do
            ((total++))
            if command -v "$tool" &>/dev/null || dpkg -l "$tool" 2>/dev/null | grep -q '^ii'; then
                ((installed++))
            fi
        done
        local status_color="${RED}"
        local status_text="Not Installed"
        if [[ $installed -eq $total ]]; then
            status_color="${GREEN}"
            status_text="Full"
        elif [[ $installed -gt 0 ]]; then
            status_color="${YELLOW}"
            status_text="Partial (${installed}/${total})"
        fi
        printf "  %-20s %-12s ${status_color}%s${NC}\n" "$cat_name" "${installed}/${total}" "$status_text"
    done
    echo ""
}

cmd_install_category() {
    check_root
    local cat_id="$1"
    local var_name="CATEGORY_${cat_id^^}"
    local tools="${!var_name:-}"
    
    if [[ -z "$tools" ]]; then
        echo -e "${RED}[!] Unknown category: ${cat_id}${NC}"
        echo -e "${DIM}Available: recon, exploit, webapp, wireless, password, network, forensics, reverse, crypto, server${NC}"
        return 1
    fi

    echo -e "${CYAN}[*] Installing ${cat_id} tools...${NC}"
    for tool in $tools; do
        echo -e "${DIM}  → ${tool}${NC}"
        apt-get install -y "$tool" 2>/dev/null || echo -e "${YELLOW}  ⚠ ${tool} not available in repo${NC}"
    done
    echo -e "${GREEN}[✓] Category '${cat_id}' installation complete${NC}"
}

cmd_full_arsenal() {
    check_root
    echo -e "${BOLD}${RED}[!] Installing FULL RatanaOS Security Arsenal${NC}"
    echo -e "${DIM}This will install all security tools across all categories.${NC}"
    
    for cat in recon exploit webapp wireless password network forensics reverse crypto server; do
        cmd_install_category "$cat"
    done
    
    echo -e "\n${GREEN}${BOLD}[✓] Full RatanaOS Security Arsenal deployed!${NC}"
}

# ── Entry ──
case "${1:-help}" in
    install)    shift; cmd_install "$@" ;;
    remove)     shift; cmd_remove "$@" ;;
    update)     cmd_update ;;
    upgrade)    cmd_upgrade ;;
    search)     shift; cmd_search "$@" ;;
    list)       cmd_list ;;
    info)       shift; cmd_info "$@" ;;
    arsenal)    cmd_arsenal ;;
    install-category) shift; cmd_install_category "$@" ;;
    full-arsenal)     cmd_full_arsenal ;;
    *)
        banner
        echo ""
        echo -e "  ${BOLD}Package Management:${NC}"
        echo "    ratapkg install <pkg>        Install packages"
        echo "    ratapkg remove <pkg>         Remove packages"
        echo "    ratapkg update               Update package database"
        echo "    ratapkg upgrade              Upgrade all packages"
        echo "    ratapkg search <query>       Search packages"
        echo "    ratapkg list                 List installed packages"
        echo "    ratapkg info <pkg>           Package information"
        echo ""
        echo -e "  ${BOLD}Security Arsenal:${NC}"
        echo "    ratapkg arsenal              Show security tool status"
        echo "    ratapkg install-category <cat>  Install tool category"
        echo "    ratapkg full-arsenal         Install ALL security tools"
        echo ""
        echo -e "  ${BOLD}Categories:${NC} recon, exploit, webapp, wireless, password,"
        echo "              network, forensics, reverse, crypto, server"
        echo ""
        ;;
esac
