#!/bin/bash
# ============================================================================
# ratanaos-forensics — RatanaOS Digital Forensics Toolkit
# ============================================================================
# Memory analysis, disk forensics, file carving, and log analysis.
# ============================================================================

set -euo pipefail

VERSION="1.0.0"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

EVIDENCE_DIR="${HOME}/.ratanaos/forensics"
mkdir -p "${EVIDENCE_DIR}"

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ╦═╗╔═╗╔╦╗╔═╗  ╔═╗╔═╗╦═╗╔═╗╔╗╔╔═╗╦╔═╗╔═╗"
    echo "  ╠╦╝╠═╣ ║ ╠═╣  ╠╣ ║ ║╠╦╝║╣ ║║║╚═╗║║  ╚═╗"
    echo "  ╩╚═╩ ╩ ╩ ╩ ╩  ╚  ╚═╝╩╚═╚═╝╝╚╝╚═╝╩╚═╝╚═╝"
    echo -e "${NC}${DIM}  RatanaOS Digital Forensics v${VERSION}${NC}"
    echo ""
}

timestamp() { date +%Y%m%d_%H%M%S; }

# ── Disk Image ──
cmd_image() {
    local device="${1:?Usage: ratanaos-forensics image <device> [output]}"
    local output="${2:-${EVIDENCE_DIR}/disk_image_$(timestamp).dd}"

    banner
    echo -e "${CYAN}[*] Creating forensic disk image...${NC}"
    echo -e "  ${CYAN}Source:${NC} ${device}"
    echo -e "  ${CYAN}Output:${NC} ${output}"

    if command -v dc3dd &>/dev/null; then
        dc3dd if="$device" of="$output" hash=sha256 log="${output}.log"
    else
        dd if="$device" of="$output" bs=4M status=progress conv=noerror,sync
        sha256sum "$output" > "${output}.sha256"
    fi

    echo -e "${GREEN}[✓] Disk image created: ${output}${NC}"
    echo -e "${GREEN}[✓] Hash: $(cat ${output}.sha256 2>/dev/null || sha256sum ${output} | cut -d' ' -f1)${NC}"
}

# ── File Carving ──
cmd_carve() {
    local image="${1:?Usage: ratanaos-forensics carve <image-file> [output-dir]}"
    local outdir="${2:-${EVIDENCE_DIR}/carved_$(timestamp)}"

    banner
    echo -e "${CYAN}[*] Carving files from: ${image}${NC}"
    mkdir -p "$outdir"

    if command -v foremost &>/dev/null; then
        foremost -i "$image" -o "$outdir" -v
    elif command -v binwalk &>/dev/null; then
        binwalk --dd='.*' -e "$image" -C "$outdir"
    elif command -v scalpel &>/dev/null; then
        scalpel "$image" -o "$outdir"
    else
        echo -e "${RED}[!] No carving tool found. Install: ratapkg install foremost binwalk${NC}"
        return 1
    fi

    echo -e "${GREEN}[✓] Carved files saved to: ${outdir}${NC}"
    echo -e "  Files found: $(find ${outdir} -type f | wc -l)"
}

# ── Metadata Extraction ──
cmd_metadata() {
    local file="${1:?Usage: ratanaos-forensics metadata <file>}"

    banner
    echo -e "${CYAN}[*] Extracting metadata: ${file}${NC}"

    if command -v exiftool &>/dev/null; then
        exiftool "$file"
    else
        echo -e "${BOLD}── File Information ──${NC}"
        file "$file"
        echo ""
        stat "$file"
        echo ""

        # Try strings for embedded data
        echo -e "${BOLD}── Embedded Strings (first 50) ──${NC}"
        strings "$file" | head -50
    fi
}

# ── Hash Analysis ──
cmd_hash() {
    local target="${1:?Usage: ratanaos-forensics hash <file-or-dir>}"
    local outfile="${EVIDENCE_DIR}/hashes_$(timestamp).txt"

    banner
    echo -e "${CYAN}[*] Computing hashes: ${target}${NC}"
    echo "# RatanaOS Hash Analysis — $(date)" > "$outfile"

    if [[ -f "$target" ]]; then
        echo -e "  ${CYAN}MD5:${NC}    $(md5sum "$target" | cut -d' ' -f1)" | tee -a "$outfile"
        echo -e "  ${CYAN}SHA1:${NC}   $(sha1sum "$target" | cut -d' ' -f1)" | tee -a "$outfile"
        echo -e "  ${CYAN}SHA256:${NC} $(sha256sum "$target" | cut -d' ' -f1)" | tee -a "$outfile"
        echo -e "  ${CYAN}SHA512:${NC} $(sha512sum "$target" | cut -d' ' -f1)" | tee -a "$outfile"
    elif [[ -d "$target" ]]; then
        echo -e "  ${DIM}Hashing all files in directory...${NC}"
        find "$target" -type f -exec sha256sum {} \; | tee -a "$outfile"
    fi

    echo -e "\n${GREEN}[✓] Hashes saved: ${outfile}${NC}"
}

# ── Timeline Analysis ──
cmd_timeline() {
    local target="${1:?Usage: ratanaos-forensics timeline <directory>}"
    local outfile="${EVIDENCE_DIR}/timeline_$(timestamp).csv"

    banner
    echo -e "${CYAN}[*] Building filesystem timeline: ${target}${NC}"

    echo "Timestamp,Type,Size,Permissions,Path" > "$outfile"
    find "$target" -type f -printf '%T+ %t modified %s %M %p\n' 2>/dev/null | \
        sort | while read -r line; do
            echo "$line" | tee -a "$outfile"
        done

    echo -e "\n${GREEN}[✓] Timeline saved: ${outfile}${NC}"
    echo -e "  Total files analyzed: $(wc -l < ${outfile})"
}

# ── Log Analysis ──
cmd_logs() {
    local logdir="${1:-/var/log}"

    banner
    echo -e "${CYAN}[*] Analyzing system logs: ${logdir}${NC}"
    local outfile="${EVIDENCE_DIR}/log_analysis_$(timestamp).txt"

    echo "# RatanaOS Log Analysis — $(date)" > "$outfile"

    # Auth logs
    echo -e "\n${BOLD}── Authentication Failures ──${NC}" | tee -a "$outfile"
    grep -i "failed\|failure\|invalid" "${logdir}/auth.log" 2>/dev/null | tail -20 | tee -a "$outfile"

    # SSH attempts
    echo -e "\n${BOLD}── SSH Brute Force Attempts ──${NC}" | tee -a "$outfile"
    grep "sshd.*Failed password" "${logdir}/auth.log" 2>/dev/null | \
        awk '{print $(NF-3)}' | sort | uniq -c | sort -rn | head -10 | tee -a "$outfile"

    # Root logins
    echo -e "\n${BOLD}── Root Logins ──${NC}" | tee -a "$outfile"
    grep "session opened.*root" "${logdir}/auth.log" 2>/dev/null | tail -10 | tee -a "$outfile"

    # Sudo activity
    echo -e "\n${BOLD}── Sudo Activity ──${NC}" | tee -a "$outfile"
    grep "sudo:" "${logdir}/auth.log" 2>/dev/null | tail -10 | tee -a "$outfile"

    # Kernel messages
    echo -e "\n${BOLD}── Kernel Warnings/Errors ──${NC}" | tee -a "$outfile"
    dmesg 2>/dev/null | grep -i "error\|warning\|fail\|critical" | tail -10 | tee -a "$outfile"

    echo -e "\n${GREEN}[✓] Log analysis saved: ${outfile}${NC}"
}

# ── Live Memory Dump ──
cmd_memdump() {
    local outfile="${1:-${EVIDENCE_DIR}/memdump_$(timestamp).raw}"

    banner
    echo -e "${RED}[*] Dumping live memory...${NC}"

    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] Memory dump requires root.${NC}"
        return 1
    fi

    if [[ -r /dev/mem ]]; then
        dd if=/dev/mem of="$outfile" bs=1M 2>/dev/null
    elif [[ -r /proc/kcore ]]; then
        cp /proc/kcore "$outfile"
    else
        # Process memory maps
        echo -e "${YELLOW}[!] /dev/mem not accessible. Dumping process maps instead.${NC}"
        for pid in /proc/[0-9]*; do
            local pname
            pname="$(cat ${pid}/comm 2>/dev/null || echo unknown)"
            cat "${pid}/maps" >> "$outfile" 2>/dev/null
        done
    fi

    echo -e "${GREEN}[✓] Memory dump saved: ${outfile}${NC}"
}

# ── Entry ──
case "${1:-help}" in
    image)    shift; cmd_image "$@" ;;
    carve)    shift; cmd_carve "$@" ;;
    metadata) shift; cmd_metadata "$@" ;;
    hash)     shift; cmd_hash "$@" ;;
    timeline) shift; cmd_timeline "$@" ;;
    logs)     cmd_logs "${2:-/var/log}" ;;
    memdump)  shift; cmd_memdump "$@" ;;
    *)
        banner
        echo -e "  ${BOLD}Usage:${NC} ratanaos-forensics <command> [args]"
        echo ""
        echo -e "  ${BOLD}Disk Forensics:${NC}"
        echo "    image    <device> [output]     Create forensic disk image"
        echo "    carve    <image> [output-dir]   File carving from image"
        echo "    metadata <file>                 Extract file metadata"
        echo "    hash     <file-or-dir>           Compute file hashes"
        echo ""
        echo -e "  ${BOLD}Analysis:${NC}"
        echo "    timeline <directory>            Build filesystem timeline"
        echo "    logs     [log-dir]              Analyze system logs"
        echo "    memdump  [output]               Dump live memory"
        echo ""
        ;;
esac
