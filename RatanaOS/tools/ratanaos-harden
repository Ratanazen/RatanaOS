#!/bin/bash
# ============================================================================
# ratanaos-harden — RatanaOS Server Hardening Tool
# ============================================================================
# Automates security hardening for RatanaOS servers.
# ============================================================================

set -euo pipefail

VERSION="1.0.0"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

LOG_FILE="/var/log/ratanaos-harden.log"

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ╦═╗╔═╗╔╦╗╔═╗  ╦ ╦╔═╗╦═╗╔╦╗╔═╗╔╗╔"
    echo "  ╠╦╝╠═╣ ║ ╠═╣  ╠═╣╠═╣╠╦╝ ║║║╣ ║║║"
    echo "  ╩╚═╩ ╩ ╩ ╩ ╩  ╩ ╩╩ ╩╩╚══╩╝╚═╝╝╚╝"
    echo -e "${NC}${DIM}  RatanaOS Server Hardening v${VERSION}${NC}"
    echo ""
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[!] This tool requires root. Run with sudo.${NC}"
        exit 1
    fi
}

log() { echo "[$(date -Iseconds)] $*" >> "${LOG_FILE}" 2>/dev/null || true; }

# ── Security Audit ──
cmd_audit() {
    banner
    echo -e "${BOLD}  Security Audit Report${NC}"
    echo -e "  ══════════════════════"
    echo ""

    local score=0
    local total=0

    # 1. Root SSH login
    ((total++))
    if grep -q "^PermitRootLogin no" /etc/ssh/sshd_config 2>/dev/null; then
        echo -e "  ${GREEN}[✓]${NC} Root SSH login disabled"
        ((score++))
    else
        echo -e "  ${RED}[✗]${NC} Root SSH login NOT disabled"
    fi

    # 2. SSH password authentication
    ((total++))
    if grep -q "^PasswordAuthentication no" /etc/ssh/sshd_config 2>/dev/null; then
        echo -e "  ${GREEN}[✓]${NC} SSH password auth disabled (key-only)"
        ((score++))
    else
        echo -e "  ${YELLOW}[~]${NC} SSH password auth enabled (consider key-only)"
    fi

    # 3. Firewall
    ((total++))
    if systemctl is-active --quiet ufw 2>/dev/null || iptables -L -n 2>/dev/null | grep -q "DROP"; then
        echo -e "  ${GREEN}[✓]${NC} Firewall active"
        ((score++))
    else
        echo -e "  ${RED}[✗]${NC} No firewall detected"
    fi

    # 4. Fail2Ban
    ((total++))
    if systemctl is-active --quiet fail2ban 2>/dev/null; then
        echo -e "  ${GREEN}[✓]${NC} Fail2Ban active"
        ((score++))
    else
        echo -e "  ${YELLOW}[~]${NC} Fail2Ban not active"
    fi

    # 5. Automatic updates
    ((total++))
    if systemctl is-active --quiet unattended-upgrades 2>/dev/null || \
       [[ -f /etc/apt/apt.conf.d/20auto-upgrades ]]; then
        echo -e "  ${GREEN}[✓]${NC} Automatic security updates configured"
        ((score++))
    else
        echo -e "  ${YELLOW}[~]${NC} Automatic updates not configured"
    fi

    # 6. World-writable files
    ((total++))
    local ww_count
    ww_count="$(find / -xdev -type f -perm -0002 2>/dev/null | wc -l)"
    if [[ $ww_count -eq 0 ]]; then
        echo -e "  ${GREEN}[✓]${NC} No world-writable files found"
        ((score++))
    else
        echo -e "  ${YELLOW}[~]${NC} ${ww_count} world-writable files found"
    fi

    # 7. SUID binaries
    ((total++))
    local suid_count
    suid_count="$(find / -xdev -type f -perm -4000 2>/dev/null | wc -l)"
    if [[ $suid_count -lt 20 ]]; then
        echo -e "  ${GREEN}[✓]${NC} SUID binaries: ${suid_count} (within expected range)"
        ((score++))
    else
        echo -e "  ${YELLOW}[~]${NC} SUID binaries: ${suid_count} (review recommended)"
    fi

    # 8. Open ports
    ((total++))
    local port_count
    port_count="$(ss -tlnp 2>/dev/null | tail -n+2 | wc -l)"
    echo -e "  ${CYAN}[i]${NC} Open listening ports: ${port_count}"
    ss -tlnp 2>/dev/null | tail -n+2 | awk '{printf "      %s\n", $4}'
    ((score++))

    # 9. Kernel hardening
    ((total++))
    if [[ "$(sysctl -n kernel.randomize_va_space 2>/dev/null)" == "2" ]]; then
        echo -e "  ${GREEN}[✓]${NC} ASLR enabled"
        ((score++))
    else
        echo -e "  ${RED}[✗]${NC} ASLR not fully enabled"
    fi

    # 10. No empty passwords
    ((total++))
    if ! awk -F: '($2 == "") {print}' /etc/shadow 2>/dev/null | grep -q .; then
        echo -e "  ${GREEN}[✓]${NC} No empty password accounts"
        ((score++))
    else
        echo -e "  ${RED}[✗]${NC} Accounts with empty passwords found!"
    fi

    echo ""
    local pct=$((score * 100 / total))
    local color="${RED}"
    [[ $pct -ge 50 ]] && color="${YELLOW}"
    [[ $pct -ge 80 ]] && color="${GREEN}"
    echo -e "  ${BOLD}Security Score: ${color}${score}/${total} (${pct}%)${NC}"
    echo ""
}

# ── SSH Hardening ──
cmd_ssh() {
    check_root
    banner
    echo -e "${CYAN}[*] Hardening SSH configuration...${NC}"

    local sshd="/etc/ssh/sshd_config"
    [[ ! -f "$sshd" ]] && { echo -e "${RED}[!] sshd_config not found${NC}"; return 1; }

    cp "$sshd" "${sshd}.bak.$(date +%s)"

    # Apply hardening
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' "$sshd"
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' "$sshd"
    sed -i 's/^#*PermitEmptyPasswords.*/PermitEmptyPasswords no/' "$sshd"
    sed -i 's/^#*X11Forwarding.*/X11Forwarding no/' "$sshd"
    sed -i 's/^#*MaxAuthTries.*/MaxAuthTries 3/' "$sshd"
    sed -i 's/^#*ClientAliveInterval.*/ClientAliveInterval 300/' "$sshd"
    sed -i 's/^#*ClientAliveCountMax.*/ClientAliveCountMax 2/' "$sshd"
    sed -i 's/^#*Protocol.*/Protocol 2/' "$sshd"

    # Add banner
    echo "Banner /etc/ssh/ratanaos-banner" >> "$sshd"
    cat > /etc/ssh/ratanaos-banner << 'EOF'

═══════════════════════════════════════════════════
  RatanaOS Security Server
  Unauthorized access is prohibited and monitored.
  All sessions are logged.
═══════════════════════════════════════════════════

EOF

    systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null || true
    echo -e "${GREEN}[✓] SSH hardened${NC}"
    log "SSH hardened"
}

# ── Firewall Setup ──
cmd_firewall() {
    check_root
    banner
    echo -e "${CYAN}[*] Configuring firewall (UFW)...${NC}"

    if ! command -v ufw &>/dev/null; then
        apt-get install -y ufw 2>/dev/null
    fi

    ufw default deny incoming
    ufw default allow outgoing
    ufw allow ssh
    ufw --force enable

    echo -e "${GREEN}[✓] Firewall active — SSH allowed, all other incoming denied${NC}"
    echo -e "${DIM}    Use 'ufw allow <port>' to open additional ports${NC}"
    log "Firewall configured"
}

# ── Fail2Ban Setup ──
cmd_fail2ban() {
    check_root
    banner
    echo -e "${CYAN}[*] Configuring Fail2Ban...${NC}"

    if ! command -v fail2ban-client &>/dev/null; then
        apt-get install -y fail2ban 2>/dev/null
    fi

    cat > /etc/fail2ban/jail.local << 'EOF'
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3
banaction = ufw

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3

[sshd-ddos]
enabled = true
port = ssh
filter = sshd-ddos
logpath = /var/log/auth.log
maxretry = 6
EOF

    systemctl enable fail2ban
    systemctl restart fail2ban
    echo -e "${GREEN}[✓] Fail2Ban configured and active${NC}"
    log "Fail2Ban configured"
}

# ── Kernel Hardening ──
cmd_kernel() {
    check_root
    banner
    echo -e "${CYAN}[*] Applying kernel hardening (sysctl)...${NC}"

    cat > /etc/sysctl.d/99-ratanaos-hardening.conf << 'EOF'
# RatanaOS Kernel Hardening
# Network
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1

# Kernel
kernel.randomize_va_space = 2
kernel.kptr_restrict = 2
kernel.yama.ptrace_scope = 1
kernel.dmesg_restrict = 1
kernel.core_uses_pid = 1
kernel.sysrq = 0

# Filesystem
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
fs.suid_dumpable = 0
EOF

    sysctl --system 2>/dev/null
    echo -e "${GREEN}[✓] Kernel hardening applied${NC}"
    log "Kernel hardened"
}

# ── Full Hardening ──
cmd_full() {
    check_root
    banner
    echo -e "${RED}${BOLD}[*] Full RatanaOS Server Hardening${NC}"
    echo ""
    cmd_ssh
    cmd_firewall
    cmd_fail2ban
    cmd_kernel
    echo ""
    echo -e "${GREEN}${BOLD}[✓] Full hardening complete!${NC}"
    echo -e "${DIM}    Run 'ratanaos-harden audit' to verify.${NC}"
}

# ── Entry ──
case "${1:-help}" in
    audit)    cmd_audit ;;
    ssh)      cmd_ssh ;;
    firewall) cmd_firewall ;;
    fail2ban) cmd_fail2ban ;;
    kernel)   cmd_kernel ;;
    full)     cmd_full ;;
    *)
        banner
        echo -e "  ${BOLD}Usage:${NC} ratanaos-harden <command>"
        echo ""
        echo -e "  ${BOLD}Commands:${NC}"
        echo "    audit      Security audit and scoring"
        echo "    ssh        Harden SSH configuration"
        echo "    firewall   Configure UFW firewall"
        echo "    fail2ban   Setup Fail2Ban intrusion prevention"
        echo "    kernel     Apply kernel security parameters"
        echo "    full       Apply ALL hardening measures"
        echo ""
        ;;
esac
