#!/bin/bash
# ============================================================================
# ratanaos-recon — RatanaOS OSINT & Reconnaissance Framework
# ============================================================================
# Automated reconnaissance and intelligence gathering for RatanaOS.
# ============================================================================

set -euo pipefail

VERSION="1.0.0"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

RESULTS_DIR="${HOME}/.ratanaos/recon"
mkdir -p "${RESULTS_DIR}"

banner() {
    echo -e "${MAGENTA}${BOLD}"
    echo "  ╦═╗╔═╗╔╦╗╔═╗  ╦═╗╔═╗╔═╗╔═╗╔╗╔"
    echo "  ╠╦╝╠═╣ ║ ╠═╣  ╠╦╝║╣ ║  ║ ║║║║"
    echo "  ╩╚═╩ ╩ ╩ ╩ ╩  ╩╚═╚═╝╚═╝╚═╝╝╚╝"
    echo -e "${NC}${DIM}  RatanaOS Reconnaissance v${VERSION}${NC}"
    echo ""
}

timestamp() { date +%Y%m%d_%H%M%S; }

# ── Domain Recon ──
cmd_domain() {
    local domain="${1:?Usage: ratanaos-recon domain <domain>}"
    local outfile="${RESULTS_DIR}/domain_${domain}_$(timestamp).txt"

    banner
    echo -e "${CYAN}[*] Domain reconnaissance: ${domain}${NC}"
    echo "# RatanaOS Domain Recon — ${domain} — $(date)" > "$outfile"

    # WHOIS
    echo -e "\n${BOLD}── WHOIS ──${NC}" | tee -a "$outfile"
    if command -v whois &>/dev/null; then
        whois "$domain" 2>/dev/null | head -40 | tee -a "$outfile"
    else
        echo -e "  ${DIM}whois not available${NC}"
    fi

    # DNS Records
    echo -e "\n${BOLD}── DNS Records ──${NC}" | tee -a "$outfile"
    for type in A AAAA MX NS TXT SOA CNAME; do
        local result
        result="$(dig +short "$domain" "$type" 2>/dev/null)"
        if [[ -n "$result" ]]; then
            echo -e "  ${CYAN}${type}${NC}" | tee -a "$outfile"
            echo "$result" | sed 's/^/    /' | tee -a "$outfile"
        fi
    done

    # Subdomains (DNS brute)
    echo -e "\n${BOLD}── Subdomain Discovery ──${NC}" | tee -a "$outfile"
    local subs=("www" "mail" "ftp" "admin" "api" "dev" "staging" "test" "blog" "shop"
                "app" "cdn" "static" "media" "ns1" "ns2" "mx" "vpn" "remote" "portal"
                "git" "gitlab" "jenkins" "ci" "docs" "wiki" "forum" "support" "help"
                "monitor" "status" "dashboard" "panel" "db" "database" "redis" "elastic"
                "grafana" "prometheus" "kibana" "sentry" "auth" "sso" "login" "oauth"
                "backup" "storage" "s3" "assets" "images" "img" "video" "download")
    for sub in "${subs[@]}"; do
        local ip
        ip="$(dig +short "${sub}.${domain}" A 2>/dev/null | head -1)"
        if [[ -n "$ip" ]]; then
            echo -e "  ${GREEN}[FOUND]${NC} ${sub}.${domain} → ${ip}" | tee -a "$outfile"
        fi
    done

    # HTTP check
    echo -e "\n${BOLD}── HTTP Analysis ──${NC}" | tee -a "$outfile"
    for proto in "https" "http"; do
        local code
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "${proto}://${domain}" 2>/dev/null)"
        if [[ "$code" != "000" ]]; then
            echo -e "  ${CYAN}${proto}://${domain}${NC} → HTTP ${code}" | tee -a "$outfile"
            
            # Headers
            local server
            server="$(curl -sI --max-time 5 "${proto}://${domain}" 2>/dev/null | grep -i '^Server:' | head -1)"
            [[ -n "$server" ]] && echo -e "    Server: ${server#*: }" | tee -a "$outfile"
        fi
    done

    # SSL/TLS
    echo -e "\n${BOLD}── SSL/TLS Certificate ──${NC}" | tee -a "$outfile"
    echo | openssl s_client -connect "${domain}:443" -servername "$domain" 2>/dev/null | \
        openssl x509 -noout -dates -subject -issuer 2>/dev/null | tee -a "$outfile"

    echo -e "\n${GREEN}[✓] Results saved: ${outfile}${NC}"
}

# ── IP Recon ──
cmd_ip() {
    local ip="${1:?Usage: ratanaos-recon ip <ip-address>}"
    local outfile="${RESULTS_DIR}/ip_${ip}_$(timestamp).txt"

    banner
    echo -e "${CYAN}[*] IP reconnaissance: ${ip}${NC}"
    echo "# RatanaOS IP Recon — ${ip} — $(date)" > "$outfile"

    # GeoIP
    echo -e "\n${BOLD}── GeoIP Information ──${NC}" | tee -a "$outfile"
    curl -s "https://ipinfo.io/${ip}/json" 2>/dev/null | tee -a "$outfile"

    # Reverse DNS
    echo -e "\n${BOLD}── Reverse DNS ──${NC}" | tee -a "$outfile"
    dig +short -x "$ip" 2>/dev/null | tee -a "$outfile"

    # Port scan
    echo -e "\n${BOLD}── Top Ports ──${NC}" | tee -a "$outfile"
    if command -v nmap &>/dev/null; then
        nmap -T4 --top-ports 20 -sV "$ip" 2>/dev/null | tee -a "$outfile"
    else
        for port in 21 22 23 25 53 80 110 143 443 445 993 995 3306 3389 5432 8080 8443; do
            (echo >/dev/tcp/${ip}/${port}) 2>/dev/null && \
                echo -e "  ${GREEN}[OPEN]${NC} ${ip}:${port}" | tee -a "$outfile"
        done
    fi

    echo -e "\n${GREEN}[✓] Results saved: ${outfile}${NC}"
}

# ── Email Harvesting ──
cmd_email() {
    local domain="${1:?Usage: ratanaos-recon email <domain>}"
    local outfile="${RESULTS_DIR}/email_${domain}_$(timestamp).txt"

    banner
    echo -e "${CYAN}[*] Email harvesting: ${domain}${NC}"
    echo "# RatanaOS Email Harvest — ${domain} — $(date)" > "$outfile"

    if command -v theHarvester &>/dev/null || command -v theharvester &>/dev/null; then
        theharvester -d "$domain" -l 100 -b all 2>/dev/null | tee -a "$outfile"
    else
        # Manual scraping from common sources
        echo -e "${YELLOW}[!] theHarvester not found. Using basic methods.${NC}"
        
        # Search via web
        echo -e "\n${BOLD}── Search Results ──${NC}" | tee -a "$outfile"
        curl -sA "Mozilla/5.0" "https://www.google.com/search?q=%22${domain}%22+email" 2>/dev/null | \
            grep -oP '[a-zA-Z0-9._%+-]+@'"${domain}" | sort -u | tee -a "$outfile"

        # MX Records
        echo -e "\n${BOLD}── MX Records ──${NC}" | tee -a "$outfile"
        dig +short "$domain" MX 2>/dev/null | tee -a "$outfile"
    fi

    echo -e "\n${GREEN}[✓] Results saved: ${outfile}${NC}"
}

# ── Full Recon ──
cmd_full() {
    local target="${1:?Usage: ratanaos-recon full <domain>}"

    banner
    echo -e "${RED}${BOLD}[*] Full reconnaissance: ${target}${NC}"
    echo ""

    cmd_domain "$target"
    
    # Get IP and run IP recon
    local ip
    ip="$(dig +short "$target" A 2>/dev/null | head -1)"
    if [[ -n "$ip" ]]; then
        cmd_ip "$ip"
    fi
    
    cmd_email "$target"

    echo -e "\n${GREEN}${BOLD}[✓] Full recon complete! Results in: ${RESULTS_DIR}/${NC}"
}

# ── Entry ──
case "${1:-help}" in
    domain) shift; cmd_domain "$@" ;;
    ip)     shift; cmd_ip "$@" ;;
    email)  shift; cmd_email "$@" ;;
    full)   shift; cmd_full "$@" ;;
    *)
        banner
        echo -e "  ${BOLD}Usage:${NC} ratanaos-recon <command> <target>"
        echo ""
        echo -e "  ${BOLD}Commands:${NC}"
        echo "    domain <domain>    Domain OSINT (WHOIS, DNS, subdomains, SSL)"
        echo "    ip     <ip>        IP reconnaissance (GeoIP, rDNS, ports)"
        echo "    email  <domain>    Email harvesting"
        echo "    full   <domain>    Full automated recon"
        echo ""
        ;;
esac
