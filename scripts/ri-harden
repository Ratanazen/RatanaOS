#!/usr/bin/env bash
# ==============================================================================
# RiOS Zero-Trust Hardening & Defense Baseline (1.0.0)
# Enforces enterprise security posture: AppArmor, SSH, Sysctl, and UFW firewalls
# ==============================================================================

set -euo pipefail

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

print_banner() {
    echo -e "${BLUE}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║       RiOS Zero-Trust Hardening & Defense Hub            ║"
    echo "║       Kernel Sysctl, SSH, Firewall & AppArmor Baseline   ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

usage() {
    print_banner
    echo -e "${BOLD}Usage:${NC} sudo ri-harden <command>"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  audit             Perform security posture & compliance audit"
    echo "  sysctl            Apply hardened kernel security sysctl parameters"
    echo "  ssh               Harden OpenSSH daemon (disable root login, enforce key auth)"
    echo "  firewall          Enforce strict default-deny UFW firewall rules"
    echo "  all               Apply all security baseline hardening"
    echo "  help              Show this help"
    echo ""
    exit 0
}

cmd_audit() {
    print_banner
    echo -e "${BOLD}=== System Hardening & Compliance Audit ===${NC}"

    # 1. Firewall
    if command -v ufw >/dev/null 2>&1; then
        local ufw_status="inactive"
        if [ -f /etc/ufw/ufw.conf ] && grep -qi "ENABLED=yes" /etc/ufw/ufw.conf; then
            ufw_status="active"
        elif sudo -n true 2>/dev/null; then
            ufw_status=$(sudo -n ufw status 2>/dev/null | grep -i "Status" | awk '{print $2}' || echo "inactive")
        fi

        if [ "$ufw_status" = "active" ]; then
            echo -e "  [ ${GREEN}PASS${NC} ] UFW Firewall: Active & Enforcing"
        else
            echo -e "  [ ${YELLOW}WARN${NC} ] UFW Firewall: Inactive (run 'sudo ri-harden firewall')"
        fi
    else
        echo -e "  [ ${RED}FAIL${NC} ] UFW not installed"
    fi

    # 2. AppArmor
    if [ -d /sys/kernel/security/apparmor ]; then
        echo -e "  [ ${GREEN}PASS${NC} ] AppArmor: Kernel security module active"
    elif command -v apparmor_status >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        local aa_enforce
        aa_enforce=$(sudo -n apparmor_status 2>/dev/null | grep "profiles are in enforce mode" | awk '{print $1}' || echo "0")
        echo -e "  [ ${GREEN}PASS${NC} ] AppArmor: Active (${aa_enforce} profiles in enforce mode)"
    else
        echo -e "  [ ${YELLOW}WARN${NC} ] AppArmor: Not active"
    fi

    # 3. SSH Configuration
    local sshd_config="/etc/ssh/sshd_config"
    if [ -f "$sshd_config" ]; then
        if grep -q -E "^PermitRootLogin (no|prohibit-password)" "$sshd_config"; then
            echo -e "  [ ${GREEN}PASS${NC} ] OpenSSH: Root login prohibited"
        else
            echo -e "  [ ${YELLOW}WARN${NC} ] OpenSSH: PermitRootLogin not strictly restricted"
        fi
    fi

    # 4. Network Security Parameters
    local syncookies
    syncookies=$(sysctl -n net.ipv4.tcp_syncookies 2>/dev/null || echo "0")
    if [ "$syncookies" = "1" ]; then
        echo -e "  [ ${GREEN}PASS${NC} ] Kernel SYN Flood Defense: Enabled"
    else
        echo -e "  [ ${YELLOW}WARN${NC} ] Kernel SYN Flood Defense: Disabled"
    fi
    echo ""
}

cmd_sysctl() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${CYAN}Applying Hardened Kernel Parameters (/etc/sysctl.d/99-rios-security.conf)...${NC}"
    cat << 'EOF' > /etc/sysctl.d/99-rios-security.conf
# RiOS Kernel Hardening & Defense Baseline
# Prevent SYN flood attacks
net.ipv4.tcp_syncookies = 1

# Ignore ICMP broadcast echo requests (Smurf attacks)
net.ipv4.icmp_echo_ignore_broadcasts = 1

# Do not send ICMP redirects
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

# Do not accept ICMP redirects
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# Enable reverse path filtering (spoofing protection)
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

# Log martian packets (spoofed addresses)
net.ipv4.conf.all.log_martians = 1

# Restrict dmesg access to root only
kernel.dmesg_restrict = 1

# Restrict BPF JIT compiler
kernel.unprivileged_bpf_disabled = 1

# Address space layout randomization (ASLR)
kernel.randomize_va_space = 2
EOF

    sysctl --system >/dev/null 2>&1 || true
    echo -e "${GREEN}✔ Kernel hardening parameters applied successfully!${NC}"
}

cmd_ssh() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${CYAN}Hardening OpenSSH Configuration...${NC}"
    mkdir -p /etc/ssh/sshd_config.d/
    cat << 'EOF' > /etc/ssh/sshd_config.d/99-rios-hardening.conf
# RiOS SSH Hardening Configuration
PermitRootLogin prohibit-password
MaxAuthTries 4
ClientAliveInterval 300
ClientAliveCountMax 2
X11Forwarding no
EOF

    if systemctl is-active --quiet ssh 2>/dev/null; then
        systemctl restart ssh
        echo -e "${GREEN}✔ SSH configuration reloaded.${NC}"
    else
        echo -e "${GREEN}✔ SSH hardening rule written.${NC}"
    fi
}

cmd_firewall() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}Error: Root privileges required. Run with sudo.${NC}"
        exit 1
    fi

    print_banner
    echo -e "${CYAN}Configuring Default-Deny UFW Firewall...${NC}"
    if ! command -v ufw >/dev/null 2>&1; then
        apt-get update -qq && apt-get install -y --no-install-recommends ufw
    fi

    ufw default deny incoming
    ufw default allow outgoing
    ufw allow 22/tcp comment 'SSH Remote Access'
    ufw --force enable
    echo -e "${GREEN}✔ UFW firewall enforced (default deny incoming, SSH 22 allowed).${NC}"
}

case "${1:-audit}" in
    audit)
        cmd_audit
        ;;
    sysctl)
        cmd_sysctl
        ;;
    ssh)
        cmd_ssh
        ;;
    firewall)
        cmd_firewall
        ;;
    all)
        cmd_sysctl
        cmd_ssh
        cmd_firewall
        cmd_audit
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        ;;
esac
