#!/usr/bin/env bash
# ==============================================================================
# RiOS Wireless Interface Monitor Mode Utility (2026)
# Manages Wi-Fi card monitor mode, packet injection test, and scanning
# ==============================================================================
set -euo pipefail

BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Error: This script must be run as root (use sudo).${NC}" >&2
    exit 1
fi

ACTION="${1:-status}"
IFACE="${2:-wlan0}"

case "$ACTION" in
    start)
        echo -e "${CYAN}[*] Putting interface ${IFACE} into monitor mode...${NC}"
        if command -v airmon-ng >/dev/null 2>&1; then
            airmon-ng check kill || true
            airmon-ng start "$IFACE"
        else
            ip link set "$IFACE" down
            iw dev "$IFACE" set type monitor
            ip link set "$IFACE" up
        fi
        echo -e "${GREEN}✔ Monitor mode enabled on ${IFACE}.${NC}"
        ;;
    stop)
        echo -e "${CYAN}[*] Returning interface ${IFACE} to managed mode...${NC}"
        if command -v airmon-ng >/dev/null 2>&1; then
            airmon-ng stop "${IFACE}mon" 2>/dev/null || airmon-ng stop "$IFACE" || true
            systemctl restart NetworkManager 2>/dev/null || true
        else
            ip link set "$IFACE" down
            iw dev "$IFACE" set type managed
            ip link set "$IFACE" up
            systemctl restart NetworkManager 2>/dev/null || true
        fi
        echo -e "${GREEN}✔ Managed mode restored on ${IFACE}.${NC}"
        ;;
    status|list)
        echo -e "${BOLD}Wireless Interfaces:${NC}"
        if command -v iw >/dev/null 2>&1; then
            iw dev
        else
            ip -br link show | grep -E '^wl' || echo "No wireless interfaces detected."
        fi
        ;;
    -h|--help|help)
        echo "Usage: ri-airmon [start|stop|status] [INTERFACE]"
        exit 0
        ;;
    *)
        echo "Unknown action: $ACTION"
        exit 1
        ;;
esac
