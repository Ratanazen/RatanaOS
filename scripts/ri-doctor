#!/usr/bin/env bash
# ==============================================================================
# RiOS 1.0.0 Doctor — Diagnostic & Self-Healing Utility
# Performs full audit of Desktop, Server, Cyber, Dev, and Core system configs
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

TARGET_USER="${SUDO_USER:-$USER}"
TARGET_HOME=$(eval echo "~${TARGET_USER}")
REPORT_FILE="${TARGET_HOME}/.config/ri/doctor-report.log"

PASSED_CHECKS=0
TOTAL_CHECKS=0
WARNINGS=0
ERRORS=0

log_check() {
    local status="$1"
    local desc="$2"
    local details="$3"
    TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
    if [ "$status" = "OK" ]; then
        PASSED_CHECKS=$((PASSED_CHECKS + 1))
        printf "  [ ${GREEN}PASS${NC} ] %s\n" "$desc"
    elif [ "$status" = "WARN" ]; then
        WARNINGS=$((WARNINGS + 1))
        printf "  [ ${YELLOW}WARN${NC} ] %s %s\n" "$desc" "${details:+($details)}"
    else
        ERRORS=$((ERRORS + 1))
        printf "  [ ${RED}FAIL${NC} ] %s %s\n" "$desc" "${details:+($details)}"
    fi
}

header() {
    echo -e "\n${BOLD}${CYAN}=== $1 ===${NC}"
}

doctor_check() {
    echo -e "${BOLD}${PURPLE}======================================================${NC}"
    echo -e "${BOLD}${PURPLE}          RiOS 1.0.0 System Health Audit               ${NC}"
    echo -e "${BOLD}${PURPLE}======================================================${NC}"

    header "1. Desktop Compositors & Display Sessions"
    for comp in hyprland sway gnome-shell startplasma-wayland; do
        if command -v "$comp" >/dev/null 2>&1; then
            log_check "OK" "Compositor/Desktop binary: $comp"
        else
            log_check "WARN" "Compositor/Desktop binary: $comp" "Not installed or not in PATH"
        fi
    done

    header "2. Wayland & Desktop Utilities"
    local core_tools=("waybar" "swaync" "wofi" "kitty" "foot" "swayidle" "swaylock" "grim" "slurp" "pamixer" "brightnessctl")
    for tool in "${core_tools[@]}"; do
        if command -v "$tool" >/dev/null 2>&1; then
            log_check "OK" "Desktop utility: $tool"
        else
            log_check "WARN" "Desktop utility: $tool" "Missing binary"
        fi
    done

    header "3. Server & Cloud Daemons"
    local server_tools=("sshd" "nginx" "docker" "ufw" "fail2ban" "wg" "cockpit-bridge")
    for s_tool in "${server_tools[@]}"; do
        if command -v "$s_tool" >/dev/null 2>&1; then
            log_check "OK" "Server daemon binary: $s_tool"
        else
            log_check "WARN" "Server daemon binary: $s_tool" "Not installed (Optional in desktop-only profile)"
        fi
    done

    header "4. Cybersecurity & Ethical Hacking Tools"
    local cyber_tools=("nmap" "wireshark" "tshark" "john" "hydra" "sqlmap" "binwalk" "proxychains4")
    for c_tool in "${cyber_tools[@]}"; do
        if command -v "$c_tool" >/dev/null 2>&1; then
            log_check "OK" "Cyber tool: $c_tool"
        else
            log_check "WARN" "Cyber tool: $c_tool" "Not installed (Optional in minimal profile)"
        fi
    done

    header "5. Developer Toolchain & Runtimes"
    local dev_tools=("gcc" "make" "git" "python3" "node" "cargo" "go" "nvim")
    for d_tool in "${dev_tools[@]}"; do
        if command -v "$d_tool" >/dev/null 2>&1; then
            log_check "OK" "Developer tool: $d_tool"
        else
            log_check "WARN" "Developer tool: $d_tool" "Not installed (Optional in minimal profile)"
        fi
    done

    header "6. User Configuration Files"
    local configs=(
        "hypr/hyprland.conf"
        "sway/config"
        "waybar/config"
        "waybar/style.css"
        "kitty/kitty.conf"
        "ri/theme.conf"
    )
    for cfg in "${configs[@]}"; do
        if [ -f "${TARGET_HOME}/.config/$cfg" ]; then
            log_check "OK" "User config: ~/.config/$cfg"
        elif [ -f "/etc/skel/.config/$cfg" ]; then
            log_check "WARN" "User config: ~/.config/$cfg" "Available in /etc/skel but missing for $TARGET_USER"
        else
            log_check "WARN" "User config: ~/.config/$cfg" "Missing"
        fi
    done

    header "7. RiOS 1.0.0 Helper Utilities"
    local helpers=("ri-server" "ri-launcher" "ri-lock" "ri-power" "ri-screenshot" "ri-first-run" "ri-doctor" "ri-installer")
    for h in "${helpers[@]}"; do
        if [ -x "/usr/local/bin/$h" ]; then
            log_check "OK" "Utility: /usr/local/bin/$h (executable)"
        else
            log_check "WARN" "Utility: /usr/local/bin/$h missing or not executable"
        fi
    done

    header "8. Permissions & File Ownership"
    if [ -d "${TARGET_HOME}/.config" ]; then
        local wrong_owner
        wrong_owner=$(find "${TARGET_HOME}/.config" -user root 2>/dev/null | head -n 5)
        if [ -z "$wrong_owner" ]; then
            log_check "OK" "~/.config ownership correctly belongs to $TARGET_USER"
        else
            log_check "WARN" "Some files in ~/.config are owned by root! Run 'ri-doctor fix'"
        fi
    fi

    echo ""
    echo -e "${BOLD}${PURPLE}======================================================${NC}"
    echo -e "${BOLD}Summary: ${PASSED_CHECKS}/${TOTAL_CHECKS} Checks Evaluated | ${YELLOW}${WARNINGS} Warnings${NC} | ${RED}${ERRORS} Errors${NC}"
    echo -e "${BOLD}${PURPLE}======================================================${NC}"
}

doctor_fix() {
    echo -e "${BOLD}${CYAN}[*] Starting RiOS 1.0.0 Self-Healing & Configuration Repair...${NC}"

    mkdir -p "${TARGET_HOME}/.config/ri"

    # 1. Restore missing configs from /etc/skel
    local skel_source="/etc/skel/.config"
    if [ -d "$skel_source" ]; then
        echo -e "  -> Restoring missing user configurations from ${skel_source}..."
        for dir in hypr sway waybar kitty foot ri; do
            if [ -d "${skel_source}/${dir}" ]; then
                if [ ! -d "${TARGET_HOME}/.config/${dir}" ]; then
                    cp -r "${skel_source}/${dir}" "${TARGET_HOME}/.config/"
                    echo -e "     ${GREEN}+ Restored ~/.config/${dir}${NC}"
                fi
            fi
        done
    fi

    # 2. Fix permissions and ownership
    echo -e "  -> Repairing file permissions and ownership for ${TARGET_USER}..."
    chown -R "${TARGET_USER}:${TARGET_USER}" "${TARGET_HOME}/.config" 2>/dev/null || true
    chmod -R u+rw "${TARGET_HOME}/.config" 2>/dev/null || true

    # 3. Make system scripts executable
    if [ -d "/usr/local/bin" ]; then
        chmod +x /usr/local/bin/ri-* 2>/dev/null || true
    fi

    # 4. Update font cache if present
    if command -v fc-cache >/dev/null 2>&1; then
        echo -e "  -> Refreshing font cache..."
        fc-cache -f >/dev/null 2>&1 || true
    fi

    echo -e "${GREEN}${BOLD}[✔] Self-healing complete! Run 'ri-doctor check' to verify.${NC}"
}

doctor_report() {
    mkdir -p "$(dirname "$REPORT_FILE")"
    {
        echo "=========================================================="
        echo " RiOS 1.0.0 Diagnostic Report - $(date -u)"
        echo "=========================================================="
        echo "Kernel:        $(uname -r)"
        echo "Architecture:  $(uname -m)"
        echo "Host:          $(cat /etc/hostname 2>/dev/null || hostname)"
        echo "OS:            $(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"')"
        echo "Current User:  ${TARGET_USER}"
        echo "Memory:        $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
        echo "GPU:           $(lspci 2>/dev/null | grep -E -i 'vga|3d|display' || echo 'Unknown')"
        echo ""
        echo "Running checks..."
        doctor_check
    } | tee "$REPORT_FILE"

    echo -e "\n${BOLD}${GREEN}Report saved to: ${REPORT_FILE}${NC}"
}

case "${1:-check}" in
    check)
        doctor_check
        ;;
    fix)
        doctor_fix
        ;;
    report)
        doctor_report
        ;;
    help|--help|-h)
        echo "Usage: ri-doctor [check|fix|report]"
        echo "  check   - Perform health inspection of Desktop, Server, Cyber, Dev, and Configs"
        echo "  fix     - Automatically repair broken permissions and missing configs"
        echo "  report  - Generate full diagnostic report and save to ~/.config/ri/doctor-report.log"
        ;;
    *)
        echo "Unknown option: $1"
        echo "Usage: ri-doctor [check|fix|report]"
        exit 1
        ;;
esac
