{
  "id": "ratana-cyber",
  "name": "RatanaOS Cyber",
  "version": "12.0.0",
  "description": "Cybersecurity education platform with built-in security toolkits",
  "architecture": "amd64",
  "target_size_gb": 4.0,
  "desktop": "kde",
  "display_manager": "sddm",
  "base_packages": [
    "linux-image-amd64", "live-boot", "systemd", "systemd-sysv",
    "shim-signed", "grub-efi-amd64-signed", "grub-pc-bin",
    "apparmor", "apparmor-utils", "ufw", "auditd",
    "flatpak", "curl", "wget", "rsync", "network-manager",
    "pipewire", "wireplumber", "plymouth", "plymouth-themes"
  ],
  "desktop_packages": [
    "plasma-desktop", "sddm", "kde-standard", "dolphin", "konsole", "kate"
  ],
  "extra_packages": [
    "gcc", "g++", "clang", "cmake", "git", "python3", "python3-pip",
    "rustc", "golang", "docker.io",
    "nmap", "masscan", "netcat-openbsd", "tcpdump", "traceroute",
    "nikto", "sqlmap", "dirb", "wfuzz",
    "wireshark", "tshark", "ettercap-graphical",
    "aircrack-ng", "airmon-ng", "reaver", "wifite",
    "hashcat", "john", "hydra", "medusa",
    "ghidra", "radare2", "gdb", "ltrace", "strace",
    "volatility3", "binwalk", "foremost",
    "clamav", "yara", "cutter",
    "auditd", "osquery", "chkrootkit", "rkhunter", "lynis",
    "autopsy", "sleuthkit"
  ],
  "optional_categories": {
    "digital_forensics":    ["bulk_extractor", "plaso"],
    "cloud_security":       ["awscli", "kubectl", "trivy"],
    "mobile_security":      ["apktool", "adb"],
    "exploit_frameworks":   ["metasploit-framework"]
  },
  "security_packages": ["ufw", "apparmor", "apparmor-utils", "fail2ban", "auditd"],
  "services_enable": ["NetworkManager", "sddm", "apparmor", "ufw", "auditd"],
  "services_disable": [],
  "grub_theme": "ratana-cyber",
  "plymouth_theme": "ratanaos",
  "default_settings": {
    "dark_mode": true,
    "auto_updates": true,
    "atomic_updates": true,
    "encryption_default": true
  }
}
