{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "sway/workspaces",
        "wlr/workspaces",
        "hyprland/window",
        "sway/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "custom/notification",
        "custom/power"
    ],
    "custom/logo": {
        "format": "󰀻",
        "tooltip": false,
        "on-click": "ratana-launcher"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-number": true
    },
    "sway/workspaces": {
        "format": "{name}",
        "all-outputs": true
    },
    "wlr/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 35,
        "separate-outputs": true
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 35
    },
    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1
        }
    },
    "mpris": {
        "format": "󰝚 {player_icon} {title} - {artist}",
        "format-paused": "󰝛 {player_icon} {title}",
        "player-icons": {
            "default": "󰐊",
            "spotify": "󰓇",
            "firefox": "󰈹"
        },
        "max-length": 30,
        "on-click": "playerctl play-pause"
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": true,
        "on-click": "kitty -e btop || kitty -e htop"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2,
        "tooltip-format": "Used: {used:0.1f}GiB / Total: {total:0.1f}GiB"
    },
    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰔐 {temperatureC}°C"
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭 Disconnected",
        "tooltip-format": "{ipaddr} ({signalStrength}%)",
        "on-click": "nm-connection-editor || kitty -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/notification": {
        "format": "󰂚",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "ratana-power"
    }
}
