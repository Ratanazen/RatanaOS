{
    "layer": "top",
    "position": "bottom",
    "height": 56,
    "margin-bottom": 12,
    "modules-center": [
        "custom/finder",
        "custom/terminal",
        "custom/browser",
        "custom/editor",
        "custom/calculator",
        "custom/settings",
        "custom/installer",
        "custom/trash"
    ],
    "custom/finder": {
        "format": "󰀶",
        "tooltip-format": "Finder / File Manager",
        "on-click": "thunar || dolphin || nautilus"
    },
    "custom/terminal": {
        "format": "󰞷",
        "tooltip-format": "Terminal (Kitty)",
        "on-click": "kitty || foot"
    },
    "custom/browser": {
        "format": "󰈹",
        "tooltip-format": "Web Browser (Firefox)",
        "on-click": "firefox-esr"
    },
    "custom/editor": {
        "format": "󰘔",
        "tooltip-format": "Text Editor",
        "on-click": "gnome-text-editor || mousepad || kate"
    },
    "custom/calculator": {
        "format": "󰪚",
        "tooltip-format": "Calculator",
        "on-click": "gnome-calculator || kcalc"
    },
    "custom/settings": {
        "format": "󰒓",
        "tooltip-format": "Settings",
        "on-click": "gnome-control-center || systemsettings"
    },
    "custom/installer": {
        "format": "󰐥",
        "tooltip-format": "Install RiOS",
        "on-click": "pkexec calamares"
    },
    "custom/trash": {
        "format": "󰩹",
        "tooltip-format": "Trash",
        "on-click": "thunar trash:/// || nautilus trash:///"
    }
}
