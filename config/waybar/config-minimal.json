{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "sway/workspaces",
        "wlr/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "custom/power"
    ],
    "custom/logo": {
        "format": "󰀻",
        "on-click": "ratana-launcher"
    },
    "clock": {
        "format": "{:%I:%M %p}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"]
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "ratana-power"
    }
}
