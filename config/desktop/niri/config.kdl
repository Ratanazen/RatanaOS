// ==============================================================================
// RatanaOS — Niri Master Configuration
// Infinite horizontal scrolling Wayland tiling compositor
// ==============================================================================

// Input Configuration
input {
    keyboard {
        xkb {
            layout "us,kh"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        scroll-method "two-finger"
    }

    mouse {
        accel-speed 0.0
    }
}

// Sourced modular configurations
include "layout.kdl"
include "appearance.kdl"
include "startup.kdl"
include "keybinds.kdl"

// Environment variables
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    MOZ_ENABLE_WAYLAND "1"
    QT_QPA_PLATFORM "wayland;xcb"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// Window Rules
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id="^pavucontrol$"
    open-floating true
}

window-rule {
    match app-id="^calamares$"
    open-floating true
    default-column-width { proportion 0.65; }
}

window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
}
